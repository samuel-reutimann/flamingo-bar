---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageHero from "@/components/PageHero.astro";
import HoursTable from "@/components/HoursTable.astro";
import OpenStatusPill from "@/components/OpenStatusPill.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Grid from "@/components/Grid.astro";
import Schema from "@/components/Schema.astro";
import { barSchema, breadcrumbSchema, faqSchema } from "@/utils/schema.ts";
import { getHours, getHappyHour } from "@/utils/content.ts";
import { ADDRESS_LINE } from "@/consts.ts";
import { hoursSentence, openDaysLabel } from "@/utils/hours.ts";
import _SCJ6130 from '@/assets/flamingo/_SCJ6130.webp';

/* Öffnungszeiten für das Structured Data — dieselbe Quelle wie die Tabelle. */
const hours = await getHours();

/* Happy Hour aus der Collection — stand hier zweimal getippt, unten als Fakt
   und oben in der FAQ, mit zwei verschiedenen Formulierungen derselben Zeit. */
const happyHour = await getHappyHour();

/* Die FAQ-Antwort zählte die ganze Woche noch einmal als Text auf — eine
   vierte Fassung derselben Zeiten, direkt neben der Tabelle. Jetzt gerechnet. */
const openSentence = hoursSentence(hours);
const openDaysLong = openDaysLabel(hours, { long: true });
/* Kurzform für die Meta-Description: die ausgeschriebene Wochen-Fassung
   (`openSentence`) sprengte mit 210 Zeichen die Anzeige in der Suche. */
const openDaysShort = openDaysLabel(hours);
---

<Layout
  title="Öffnungszeiten in Langenthal"
  description={`Flamingo Bar Langenthal: ${openDaysShort} geöffnet. Alle Zeiten pro Wochentag, letzter Einlass eine Stunde vor Schluss und ob gerade offen ist.`}
  theme="dark"
>
  <Schema
    slot="head"
    data={[
      barSchema(hours),
      faqSchema([
        {
          question: "Wann ist die Flamingo Bar Langenthal offen?",
          answer: openSentence,
        },
        {
          question: "Wann ist der letzte Einlass?",
          answer:
            "Eine Stunde vor Schluss. Einlass ab 18 Jahren, Ausweis mitbringen.",
        },
        ...(happyHour
          ? [
              {
                question: "Wann ist Happy Hour?",
                answer: happyHour.sentence,
              },
            ]
          : []),
        {
          question: "Kostet der Eintritt etwas?",
          answer:
            "Nein, der Eintritt ist frei. Nur an ausgewählten Events mit Live-Musik verlangen wir Eintritt; er steht dann beim Termin.",
        },
        {
          question: "Braucht es eine Reservation?",
          answer:
            "Ab sechs Personen ist ein reservierter Tisch sinnvoll, ebenso für Flaschenservice, Geburtstage und Gruppen. Sonst kommt man ohne Anmeldung.",
        },
      ]),
      breadcrumbSchema([{ name: "Öffnungszeiten", path: "/oeffnungszeiten" }]),
    ]}
  />
  <PageHero eyebrow="Öffnungszeiten" heading={openDaysLong} text="Montag bleibt die Bar geschlossen." image={_SCJ6130} imageAlt="Zwei Drinks auf der Bartheke, Neonschild im Hintergrund" glow={false}>
    <OpenStatusPill />
  </PageHero>

  <Section paddingTop="small" paddingBottom="medium" align="center">
    <HoursTable />
    <Paragraph variant="small" maxWidth={44} class="section-note">
      An Events schliessen wir teils später. Der letzte Einlass bleibt immer
      eine Stunde vor Schluss. Abweichende Zeiten kündigen wir auf Instagram,
      Facebook und TikTok an.
    </Paragraph>
  </Section>

  <Section paddingTop="small" paddingBottom="large" align="center">
    <Grid medium={3} class="hours_facts">
      <div class="hours_fact">
        <p class="hours_fact-label text-style-small">Letzter Einlass</p>
        <p class="hours_fact-value">Eine Stunde vor Schluss</p>
        <Paragraph variant="small" class="section-note">
          Einlass ab 18 Jahren, Ausweis mitbringen.
        </Paragraph>
      </div>
      {happyHour && (
        <div class="hours_fact">
          <p class="hours_fact-label text-style-small">Happy Hour</p>
          <p class="hours_fact-value">{happyHour.label}</p>
          <Paragraph variant="small" class="section-note" render={Boolean(happyHour.note)}>
            {happyHour.note}
          </Paragraph>
        </div>
      )}
      <div class="hours_fact">
        <p class="hours_fact-label text-style-small">Tisch reserviert</p>
        <p class="hours_fact-value">Ab 6 Personen</p>
        <Paragraph variant="small" class="section-note">
          Ohne Reservation können wir für Gruppen keinen Tisch freihalten.
        </Paragraph>
      </div>
    </Grid>
    <ButtonWrapper>
      <Button element="link" href="/getraenkekarte/"
        >Getränkekarte ansehen</Button
      >
      <Button element="link" href="/reservation/" variant="secondary"
        >Tisch anfragen</Button
      >
    </ButtonWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="large" align="center">
    <PageHeader
      headingTag="h2"
      variant="h3"
      maxWidth="none"
      heading="Geplant für heute Abend?"
      text={`${ADDRESS_LINE}. Fünf Minuten zu Fuss vom Bahnhof.`}
    >
      <ButtonWrapper>
        <Button element="link" href="/kontakt/" variant="secondary"
          >Anfahrt und Kontakt</Button
        >
      </ButtonWrapper>
    </PageHeader>
  </Section>
</Layout>


<style is:global>
  @layer components {

    .status_pill[hidden] {
      display: none;
    }





    .status_pill [data-open-hours] {
      color: var(--text-subtle);
    }

    .hours_facts {
      text-align: center;
    }

    .hours_fact {
      display: grid;
      gap: 0.4rem;
      justify-items: center;
    }

    .hours_fact-label {
      color: var(--text-faded);
    }

    .hours_fact-value {
      font-family: var(--display-family);
      font-size: 1.0625rem;
      margin: 0;
    }
  }
</style>
