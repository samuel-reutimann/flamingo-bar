---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
import PageHeader from "@/components/PageHeader.astro";
import HoursTable from "@/components/HoursTable.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Grid from "@/components/Grid.astro";
import Img from "@/components/Img.astro";
import mapImage from "@/assets/flamingo/map-langenthal.jpeg";
import Schema from "@/components/Schema.astro";
import { barSchema, breadcrumbSchema } from "@/utils/schema.ts";
import { getHours } from "@/utils/content.ts";
import { openDaysLabel } from "@/utils/hours.ts";
import { ADDRESS_LINE, ADDRESS_SHORT, BUSINESS } from "@/consts.ts";

/* Öffnungszeiten für das Structured Data — dieselbe Quelle wie die Tabelle. */
const hours = await getHours();
const openDaysLong = openDaysLabel(hours, { long: true });
---

<Layout
  title={`Kontakt & Anfahrt – ${BUSINESS.street}`}
  description={`Flamingo Bar, ${ADDRESS_LINE}: Telefon, WhatsApp und E-Mail, Anfahrt mit Bahn, Bus und Auto sowie alle Öffnungszeiten auf einen Blick.`}
  theme="dark"
>
  <Schema
    slot="head"
    data={[
      barSchema(hours),
      breadcrumbSchema([{ name: "Kontakt", path: "/kontakt" }]),
    ]}
  />
  <Section paddingTop="navoverlap" paddingBottom="small" align="center">
    <PageHeader
      eyebrow="Kontakt"
      heading="Direkt erreichbar"
      text="WhatsApp erreicht uns auch während des Abends. Für einen Tisch gibt es das Formular."
    >
      <ButtonWrapper>
        <Button element="link" href="/reservation/">Tisch anfragen</Button>
        <Button
          element="link"
          href={`https://wa.me/${BUSINESS.whatsapp}`}
          variant="secondary">WhatsApp</Button
        >
      </ButtonWrapper>
    </PageHeader>
  </Section>

  <Section paddingTop="small" paddingBottom="medium" align="center">
    <Grid medium={3} class="contact_channels">
      <div class="contact_channel">
        <p class="contact_label text-style-small">Telefon</p>
        <p class="contact_value">{BUSINESS.phoneDisplay}</p>
        <Button element="link" href={`tel:${BUSINESS.phone}`} variant="link"
          >Anrufen</Button
        >
      </div>
      <div class="contact_channel">
        <p class="contact_label text-style-small">WhatsApp</p>
        <p class="contact_value">{BUSINESS.phoneDisplay}</p>
        <Button
          element="link"
          href={`https://wa.me/${BUSINESS.whatsapp}`}
          variant="link">Chat öffnen</Button
        >
      </div>
      <div class="contact_channel">
        <p class="contact_label text-style-small">E-Mail</p>
        <p class="contact_value">{BUSINESS.email}</p>
        <Button element="link" href={`mailto:${BUSINESS.email}`} variant="link">
          Schreiben
        </Button>
      </div>
    </Grid>
  </Section>

  <Section paddingTop="small" paddingBottom="medium">
    <ContentWrapper
      variant="columns"
      class="measure-main"
      column2Class="contact_map radius-main"
      visualRatio="4 / 3"
    >
      <Fragment>
        <Heading tag="h2" variant="h3">{ADDRESS_SHORT}</Heading>
        <Paragraph maxWidth={34} class="section-note">
          Mitten in der Altstadt, fünf Minuten zu Fuss vom Bahnhof Langenthal.
        </Paragraph>
        <div class="def_rows contact_rows width-full">
          <div class="contact_row">
            <div>
              <Heading tag="h3" variant="h6">Mit dem ÖV</Heading>
              <Paragraph variant="small" class="section-note">
                Bahnhof Langenthal, danach fünf Minuten zu Fuss.
              </Paragraph>
            </div>
          </div>
          <div class="contact_row">
            <div>
              <Heading tag="h3" variant="h6">Mit dem Auto</Heading>
              <Paragraph variant="small" class="section-note">
                Parkhaus Marktgasse, direkt um die Ecke.
              </Paragraph>
            </div>
          </div>
          <div class="contact_row">
            <div>
              <Heading tag="h3" variant="h6">Adresse</Heading>
              <Paragraph variant="small" class="section-note">
                Flamingo Bar, {ADDRESS_LINE}
              </Paragraph>
            </div>
          </div>
        </div>
        <ButtonWrapper class="width-full">
          <Button element="link" href={BUSINESS.mapsUrl}>
            Auf Karte öffnen
          </Button>
        </ButtonWrapper>
      </Fragment>
      <Img
        slot="column2"
        src={mapImage}
        alt={`Karte mit Standort ${ADDRESS_LINE}`}
      />
    </ContentWrapper>
  </Section>

  <Section paddingTop="medium" paddingBottom="large" align="center">
    <PageHeader
      headingTag="h2"
      variant="h3"
      maxWidth="none"
      heading="Öffnungszeiten"
      text={`${openDaysLong}.`}
    />
    <HoursTable />
    <ButtonWrapper>
      <Button element="link" href="/oeffnungszeiten/" variant="secondary">
        Alle Zeiten und Hinweise
      </Button>
    </ButtonWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    /* Anders als die anderen `.def_rows` stehen Label und Wert hier
       untereinander, nicht gegenüber — die Werte sind ganze Sätze. */
    .contact_row {
      padding-block: 1.1rem;
      border-bottom: var(--border-width) solid var(--border);
    }

    .contact_channels {
      text-align: center;
    }

    .contact_channel {
      display: grid;
      gap: 0.4rem;
      justify-items: center;
      padding: var(--space-5) var(--space-4);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: color-mix(in lab, var(--text) 2%, transparent);
    }

    .contact_label {
      color: var(--text-faded);
    }

    .contact_value {
      font-family: var(--display-family);
      font-size: 1.0625rem;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .contact_map {
      overflow: clip;
    }

    .contact_map img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
</style>
