---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Img from "@/components/Img.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import Grid from "@/components/Grid.astro";
import Card from "@/components/Card.astro";
import heroImage from "@/assets/flamingo/bar-guests-night.jpeg";
import crowdImage from "@/assets/flamingo/event-crowd-dancing.jpeg";
import neonGlassesImage from "@/assets/flamingo/mood-neon-glasses.jpeg";
import cocktailHandImage from "@/assets/flamingo/mood-cocktail-hand.jpeg";
import djKnobsImage from "@/assets/flamingo/mood-dj-knobs.jpeg";
import bottleImage from "@/assets/flamingo/bottle-service-lounge.jpeg";
import mapImage from "@/assets/flamingo/map-langenthal.jpeg";
import Schema from "@/components/Schema.astro";
import { barSchema } from "@/utils/schema.ts";
import {
  getHours,
  getDrinksByCategory,
  getUpcomingEvents,
  minPriceCHF,
  bottleFromCHF,
} from "@/utils/content.ts";
import { longDate } from "@/utils/dates.ts";
import { openDaysLabel } from "@/utils/hours.ts";
import { ADDRESS_LINE, BUSINESS } from "@/consts.ts";

/* Öffnungszeiten für das Structured Data — dieselbe Quelle wie die Tabelle. */
const hours = await getHours();

/* Teaser aus denselben Collections, die `/getraenkekarte` und `/events`
   zeigen. Standen hier früher ausgeschrieben im Markup — mit einbetonierten
   Daten ("Freitag, 21. August 2026"), die nach dem Abend nie wieder stimmten,
   und mit Getränketexten, die bei jeder Keystatic-Änderung auseinanderliefen. */
const teaserDrinks = (await getDrinksByCategory("cocktails"))
  .filter((drink) => drink.data.image)
  .slice(0, 3);

/* Nur Termine mit Bild — die `cover`-Karte wäre sonst leer. */
const teaserEvents = (await getUpcomingEvents())
  .filter((event) => event.data.image)
  .slice(0, 3);

/* „Ab“-Preise gerechnet, nicht getippt: die Karte behauptete an vier Stellen
   „Cocktails ab CHF 12.–“, während der günstigste Cocktail CHF 14 kostete. */
const cocktailFrom = await minPriceCHF("cocktails");
const bottleFrom = await bottleFromCHF();
const cocktailLine = cocktailFrom ? `Cocktails ab CHF ${cocktailFrom}.–` : "Cocktails";
const bottleLine = bottleFrom ? `Flaschen ab CHF ${bottleFrom}.–` : "Flaschenservice";

/* „Do – So, ab 20 Uhr“ aus den Öffnungszeiten statt als Text daneben. */
const openDays = openDaysLabel(hours);
---

<Layout
  title="Cocktailbar in Langenthal – Drinks & DJs"
  description={`Flamingo Bar an der ${BUSINESS.street} in ${BUSINESS.city}: ${cocktailLine}, DJ-Abende, Live-Musik und Flaschenservice. ${openDays} offen.`}
  theme="dark"
>
  <Schema slot="head" data={barSchema(hours)} />
  <script is:inline slot="head">
    // Blendet den Hero vor dem ersten Paint aus, damit die Ladeanimation nicht
    // ruckelt. Ohne JS oder bei prefers-reduced-motion passiert nichts – die
    // Klasse wird nie gesetzt und der Hero ist von Anfang an sichtbar.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("hero-preload");
    }
  </script>
  <!-- HERO -->
  <section class="hero_section">
    <div class="hero_content">
      <Eyebrow class="hero_status" data-open-status hidden>
        <span class="hero_status-dot" aria-hidden="true"></span><span
          class="hero_status-text">Öffnungszeiten</span
        ><span class="hero_status-sep" aria-hidden="true"></span><span
          class="hero_status-hours"
          data-open-hours></span>
      </Eyebrow>
      <Heading tag="h1" variant="h1" class="hero_heading"
        >Deine Bar in Langenthal<br />für Cocktails und lange Nächte</Heading
      >
      <Paragraph maxWidth={38} class="hero_text"
        >{cocktailLine}, Flaschenservice und DJ-Abende. {BUSINESS.street}, {
          BUSINESS.city
        }.</Paragraph
      >
      <ButtonWrapper class="hero_buttons">
        <Button element="link" href="/getraenkekarte"
          >Getränkekarte ansehen</Button
        >
        <Button element="link" href="/reservation" variant="secondary"
          >Tisch anfragen</Button
        >
      </ButtonWrapper>
    </div>
    <div class="hero_visual">
      <Img
        src={heroImage}
        alt="Gäste an der Bartheke der Flamingo Bar bei Nacht, Neon-Pink beleuchtet"
        loading="eager"
        fetchPriority="high"
      />
      <div class="hero_scrim"></div>
    </div>
  </section>
  <!-- ÖFFNUNGSZEITEN -->
  <Section paddingTop="medium" paddingBottom="none" id="oeffnungszeiten">
    <div class="hours_strip">
      <div class="hours_strip-headline">
        <span class="hours_strip-label">Offen</span>
        <span class="hours_strip-value">{openDays}</span>
      </div>
      <div class="hours_strip-today">
        <span class="hours_strip-pill">
          <span class="hours_strip-pill-label">Heute</span>
          <span data-today-line></span>
        </span>
        <Button element="link" href="/oeffnungszeiten" variant="link"
          >Alle Zeiten</Button
        >
      </div>
    </div>
  </Section>
  <script>
    // Hero-Pill und Öffnungszeiten-Strip: Status, heutiges Zeitfenster und
    // die Heute-Zeile. Tabelle und Öffnungslogik kommen aus der gemeinsamen
    // Konstante, damit Hero, Strip und Footer nicht auseinanderlaufen.
    import {
      isOpenAt,
      todayHoursLabel,
      todayLineLabel,
    } from "@/utils/hours.ts";

    const status = document.querySelector<HTMLElement>("[data-open-status]");
    const label = status?.querySelector<HTMLElement>(".hero_status-text");
    const hours = status?.querySelector<HTMLElement>("[data-open-hours]");
    const todayLine = document.querySelector<HTMLElement>("[data-today-line]");

    function renderStatus() {
      if (!status || !label) return;
      const now = new Date();
      const open = isOpenAt(now);
      status.classList.toggle("is-closed", !open);
      label.textContent = open ? "Jetzt geöffnet" : "Jetzt geschlossen";
      if (hours) hours.textContent = todayHoursLabel(now.getDay());
      if (todayLine) todayLine.textContent = todayLineLabel(now.getDay());
      status.hidden = false;
    }

    renderStatus();
    setInterval(renderStatus, 60000);
  </script>
  <script>
    // Ladeanimation des Heros. Läuft genau einmal pro Seitenaufruf, deshalb
    // darf sie etwas länger sein als eine Interaktions-Animation.
    import { gsap } from "gsap";

    const root = document.documentElement;

    // Die Klasse setzt der Inline-Head-Script nur, wenn animiert werden darf.
    if (root.classList.contains("hero-preload")) {
      const image = document.querySelector<HTMLElement>(".hero_visual img");
      const scrim = document.querySelector<HTMLElement>(".hero_scrim");
      const pill = document.querySelector<HTMLElement>(".nav_pill");
      // Die H1 blendet nicht ein, sie wird nur versetzt: sie ist der
      // Text-LCP-Kandidat und muss beim ersten Paint lesbar sein.
      const heading = document.querySelector<HTMLElement>(".hero_heading");
      const fadeItems = [
        document.querySelector<HTMLElement>(".hero_status"),
        document.querySelector<HTMLElement>(".hero_text"),
        document.querySelector<HTMLElement>(".hero_buttons"),
      ].filter((el): el is HTMLElement => el !== null);

      const start = () => {
        // Erst freigeben, wenn GSAP die Startwerte gesetzt hat.
        gsap.set(fadeItems, { opacity: 0, y: 14, force3D: true });
        gsap.set(heading, { y: 14, force3D: true });
        // Ohne `opacity`: das Bild ist ab dem Decode sichtbar.
        gsap.set(image, { scale: 1.06, yPercent: 3, force3D: true });
        gsap.set(scrim, { opacity: 0 });
        gsap.set(pill, { opacity: 0, y: -12, force3D: true });
        root.classList.remove("hero-preload");

        const tl = gsap.timeline({
          defaults: { ease: "power3.out" },
          onComplete: () =>
            gsap.set([heading, ...fadeItems, image, scrim, pill], {
              clearProps: "all",
            }),
        });

        tl.to(image, { scale: 1, yPercent: 0, duration: 1.1 })
          .to(scrim, { opacity: 1, duration: 0.8 }, "<")
          .to(heading, { y: 0, duration: 0.6 }, "<0.15")
          .to(
            fadeItems,
            { opacity: 1, y: 0, duration: 0.6, stagger: 0.06 },
            "<",
          )
          .to(pill, { opacity: 1, y: 0, duration: 0.5 }, "<0.1");
      };

      // Auf das Hero-Bild warten, sonst startet der Reveal auf einem leeren Feld.
      const img = image as HTMLImageElement | null;
      if (img && !img.complete) {
        img.addEventListener("load", start, { once: true });
        img.addEventListener("error", start, { once: true });
      } else {
        start();
      }
    }
  </script>
  <script>
    // Scroll-Reveals für Sections, Listen und Karten. Jede Gruppe läuft genau
    // einmal – wer zurückscrollt, soll nicht dieselbe Show nochmal sehen.
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.registerPlugin(ScrollTrigger);

      // Sichtbar ab 15 % Einblendung – früh genug, dass die Bewegung schon
      // fast fertig ist, wenn das Element in der Blickmitte ankommt.
      const reveal = (
        selector: string,
        options: { stagger?: number; y?: number; scale?: number } = {},
      ) => {
        const targets = gsap.utils.toArray<HTMLElement>(selector);
        if (!targets.length) return;

        targets.forEach((target) => {
          const children = options.stagger
            ? gsap.utils.toArray<HTMLElement>(target.children)
            : [target];
          if (!children.length) return;

          gsap.from(children, {
            opacity: 0,
            y: options.y ?? 16,
            scale: options.scale ?? 1,
            duration: 0.6,
            ease: "power3.out",
            stagger: options.stagger ?? 0,
            force3D: true,
            clearProps: "all",
            scrollTrigger: { trigger: target, start: "top 85%", once: true },
          });
        });
      };

      // Überschrift, Subline und CTA einer Section laufen gestaffelt ein.
      reveal(".section-header", { stagger: 0.07 });
      // Karten und Listen: gleiche Staffelung, damit die Seite einen Takt hat.
      reveal(".menu_grid", { stagger: 0.08, y: 24 });
      reveal(".events_grid", { stagger: 0.08, y: 24 });
      reveal(".bottle_rows", { stagger: 0.08 });
      reveal(".visit_details", { stagger: 0.08 });
      // Grossflächige Bilder blenden ohne Versatz, nur mit leichtem Zoom ein.
      reveal(".bottle_visual", { y: 0, scale: 1.03 });
      reveal(".visit_map", { y: 0, scale: 1.03 });
      reveal(".gallery_marquee", { y: 0 });
      reveal(".events_note", {});
      reveal(".gallery_note", { stagger: 0.07 });
    }
  </script>
  <!-- KARTE-TEASER -->
  <Section paddingTop="medium" paddingBottom="large" align="center" id="karte">
    <div class="section-header">
      <Heading tag="h2" variant="h2">Was ein Abend<br />hier kostet</Heading>
      <Paragraph variant="main" maxWidth={40} class="section-note"
        >{cocktailLine}, {bottleLine}. Alle Preise stehen online, nicht nur auf
        der Tafel an der Bar.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="/getraenkekarte"
          >Ganze Karte ansehen</Button
        >
      </ButtonWrapper>
    </div>
    <Grid medium={3} class="menu_grid">
      {
        teaserDrinks.map((drink) => (
          <Card
            variant="stacked"
            image={drink.data.image}
            imageAlt={drink.data.imageAlt}
            heading={drink.data.name}
            text={drink.data.description}
          />
        ))
      }
    </Grid>
  </Section>
  <!-- WAS LÄUFT -->
  <Section paddingTop="medium" paddingBottom="large" align="center" id="events">
    <div class="section-header">
      <Heading tag="h2" variant="h2">Was diese Woche<br />läuft</Heading>
      <Paragraph variant="main" maxWidth={40} class="section-note"
        >DJ-Abende, Live-Musik und Motto-Partys.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="/events" variant="secondary"
          >Alle Events</Button
        >
      </ButtonWrapper>
    </div>
    <div class="events_content">
      <Grid medium={3} class="events_grid">
        {
          teaserEvents.map((event) => (
            <Card
              variant="cover"
              image={event.data.image!}
              imageAlt={event.data.imageAlt}
              eyebrow={longDate(event.data.start)}
              heading={event.data.name}
              cardTag="article"
            />
          ))
        }
      </Grid>
      <Paragraph variant="small" class="section-note events_note"
        >Jede Woche: Happy Hour am Donnerstag, 20 – 22 Uhr. Sportübertragungen
        auf Anfrage.</Paragraph
      >
    </div>
  </Section>
  <!-- ATMOSPHÄRE -->
  <Section
    paddingTop="medium"
    paddingBottom="large"
    align="center"
    id="atmosphaere"
  >
    <div class="section-header">
      <Heading tag="h2" variant="h2"
        >Licht, Musik<br />und späte Stunden</Heading
      >
      <Paragraph variant="main" class="section-note"
        >So sieht ein Abend bei uns aus.</Paragraph
      >
    </div>
  </Section>
  <div class="gallery_marquee">
    <div class="gallery_track">
      <div class="gallery_item">
        <Img
          src={neonGlassesImage}
          alt="Zwei Drinks auf der Bartheke, Neonschild im Hintergrund"
        />
      </div>
      <div class="gallery_item">
        <Img
          src={cocktailHandImage}
          alt="Hand hält einen Tumbler mit Cocktail und Eiswürfel"
        />
      </div>
      <div class="gallery_item">
        <Img
          src={djKnobsImage}
          alt="Hände am DJ-Mixer, pinker Laserstrahl über der Konsole"
        />
      </div>
      <div class="gallery_item">
        <Img
          src={crowdImage}
          alt="Feiernde Gäste auf der Tanzfläche der Flamingo Bar"
        />
      </div>
      <div class="gallery_item">
        <Img src={neonGlassesImage} alt="" aria-hidden="true" />
      </div>
      <div class="gallery_item">
        <Img src={cocktailHandImage} alt="" aria-hidden="true" />
      </div>
      <div class="gallery_item">
        <Img src={djKnobsImage} alt="" aria-hidden="true" />
      </div>
      <div class="gallery_item">
        <Img src={crowdImage} alt="" aria-hidden="true" />
      </div>
    </div>
  </div>
  <Section paddingTop="small" paddingBottom="medium" align="center">
    <div class="gallery_note">
      <Paragraph variant="small"
        >Mehr Bilder in der <a href="/galerie">Galerie</a>, kurzfristige
        Ankündigungen laufen auf Instagram.</Paragraph
      >
      <Button element="link" href={BUSINESS.instagram} variant="link"
        >{BUSINESS.instagramHandle}</Button
      >
    </div>
  </Section>
  <!-- FLASCHENSERVICE -->
  <Section paddingTop="medium" paddingBottom="medium" id="flaschenservice">
    <div class="bottle_layout">
      <div class="bottle_visual">
        <Img
          src={bottleImage}
          alt="Gäste in der Loge mit Flasche im Eiskübel und Wunderkerze"
        />
        <div class="bottle_scrim"></div>
      </div>
      <div class="bottle_text">
        <div>
          <Eyebrow>Flaschenservice</Eyebrow>
          <Heading tag="h2" variant="h2">Eine Flasche<br />an den Tisch</Heading>
        </div>
        <Paragraph maxWidth={34}
          >Für Geburtstage, Gruppen und private Abende. Ein Zusatz ist ein
          Mixgetränk wie Cola, Red Bull oder Tonic.</Paragraph
        >
        <div class="bottle_rows">
          <div class="bottle_row">
            <div>
              <Heading tag="h3" variant="h6">Flasche mit Mineral</Heading>
              <Paragraph variant="small">Rum, Vodka, Whisky oder Gin</Paragraph>
            </div>
            <p class="bottle_price">CHF 105.– bis 150.–</p>
          </div>
          <div class="bottle_row">
            <div>
              <Heading tag="h3" variant="h6">Flasche mit 2 Zusätzen</Heading>
              <Paragraph variant="small"
                >Zum Beispiel Cola und Red Bull</Paragraph
              >
            </div>
            <p class="bottle_price">Preis auf Anfrage</p>
          </div>
          <div class="bottle_row">
            <div>
              <Heading tag="h3" variant="h6">Gruppen und Geburtstage</Heading>
              <Paragraph variant="small"
                >Ab 6 Personen, Tisch reserviert</Paragraph
              >
            </div>
            <p class="bottle_price">Auf Anfrage</p>
          </div>
        </div>
        <ButtonWrapper>
          <Button element="link" href="/reservation">Tisch anfragen</Button>
          <Button
            element="link"
            href={`https://wa.me/${BUSINESS.whatsapp}`}
            variant="secondary">WhatsApp</Button
          >
        </ButtonWrapper>
      </div>
    </div>
  </Section>
  <!-- ANFAHRT UND KONTAKT -->
  <Section
    paddingTop="medium"
    paddingBottom="large"
    align="center"
    id="kontakt"
  >
    <div class="section-header">
      <Heading tag="h2" variant="h2">Mitten in Langenthal</Heading>
      <Paragraph variant="main" class="section-note"
        >Fünf Minuten zu Fuss vom Bahnhof.</Paragraph
      >
    </div>
    <Grid medium={3} class="visit_details">
      <div class="visit_detail-item">
        <p class="visit_label text-style-small">Adresse</p>
        <p class="visit_value">{ADDRESS_LINE}</p>
        <Button element="link" href={BUSINESS.mapsUrl} variant="link"
          >Auf Karte öffnen</Button
        >
      </div>
      <div class="visit_detail-item">
        <p class="visit_label text-style-small">Hinweg</p>
        <p class="visit_value">Parkhaus Marktgasse</p>
        <Paragraph variant="small">Bahnhof Langenthal, 5 Minuten</Paragraph>
      </div>
      <div class="visit_detail-item">
        <p class="visit_label text-style-small">Kontakt</p>
        <p class="visit_value">{BUSINESS.phoneDisplay}</p>
        <Paragraph variant="small">WhatsApp für Tischanfragen</Paragraph>
        <Button element="link" href="/kontakt" variant="link"
          >Anfahrt und Kontakt</Button
        >
      </div>
    </Grid>
    <div class="visit_map">
      <Img
        src={mapImage}
        alt={`Karte mit Standort ${ADDRESS_LINE}`}
      />
    </div>
  </Section>
  <!-- FINALER CTA -->
  <Section
    paddingTop="large"
    paddingBottom="large"
    align="center"
    class="cta_section"
  >
    <div class="cta_glow"></div>
    <div class="section-header">
      <Heading tag="h2" variant="h2"
        >Alles für heute Abend<br />an einem Ort</Heading
      >
      <Paragraph variant="main" maxWidth={38} class="section-note"
        >Karte, Preise und Flaschenservice, immer aktuell.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="/getraenkekarte"
          >Getränkekarte ansehen</Button
        >
        <Button element="link" href={BUSINESS.instagram} variant="secondary"
          >Instagram folgen</Button
        >
      </ButtonWrapper>
    </div>
  </Section>
</Layout>
<style is:global>
  @layer components {
    /* Haltezustand der Ladeanimation: gilt nur, solange das Head-Script die
       Klasse gesetzt hat, also nie ohne JS und nie bei reduzierter Bewegung. */
    /* Hero-Bild und H1 sind die LCP-Kandidaten und werden nie ausgeblendet —
       sonst hängt der Largest Contentful Paint an der Ausführung von GSAP.
       Beide kommen nur per Transform herein, der Rest darf einblenden. */
    .hero-preload .hero_status,
    .hero-preload .hero_text,
    .hero-preload .hero_buttons,
    .hero-preload .hero_scrim,
    .hero-preload .nav_pill {
      opacity: 0;
    }

    /* ------------------------------------------------------------------- hero */
    .hero_section {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .hero_content {
      position: relative;
      z-index: 1;
      padding-top: 9.5rem;
      padding-bottom: 1rem;
      padding-inline: var(--site-margin);
      text-align: center;
      flex: 0 0 auto;
    }

    .hero_status {
      margin-bottom: var(--space-4);
    }

    .hero_status[hidden] {
      display: none;
    }

    .hero_status-dot {
      flex: none;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: var(--radius-round);
      background-color: var(--brand-500);
      box-shadow: var(--shadow-accent-glow);
    }

    /* Der Punkt pulsiert, solange offen ist. */
    .hero_status-dot {
      animation: dot-pulse 2.4s ease-in-out infinite;
    }

    .hero_status.is-closed .hero_status-dot {
      background-color: color-mix(in lab, currentcolor 40%, transparent);
      box-shadow: none;
      animation: none;
    }

    @keyframes dot-pulse {
      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.5);
        opacity: 0.55;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero_status-dot {
        animation: none;
      }
    }

    .hero_status-sep {
      width: 1px;
      height: 0.7rem;
      background-color: color-mix(in lab, currentcolor 18%, transparent);
    }

    .hero_status-hours {
      color: color-mix(in lab, currentcolor 55%, transparent);
    }

    .hero_status .eyebrow_text {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    .hero_heading {
      max-width: 46rem;
      margin-inline: auto;
    }

    .hero_text {
      margin-inline: auto;
      margin-bottom: var(--space-5);
      color: color-mix(in lab, currentcolor 48%, transparent);
    }

    .hero_buttons {
      justify-content: center;
    }

    /* Das Bild ist ein eigener Block unter dem Text und rutscht mit negativem
       margin-top darunter. Dadurch ist die Section höher als der Viewport und
       das Bild trägt den Scroll. Der Scrim oben blendet es unter der Headline
       aus. */
    .hero_visual {
      position: relative;
      inset: auto;
      z-index: 0;
      width: 100%;
      height: 100svh;
      margin-top: -13svh;
      overflow: hidden;
    }

    .hero_visual img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 60%;
    }

    .hero_scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to bottom,
          var(--dark-900) 0%,
          color-mix(in srgb, var(--dark-900) 82%, transparent) 6%,
          color-mix(in srgb, var(--dark-900) 34%, transparent) 14%,
          transparent 24%
        ),
        linear-gradient(
          to top,
          var(--dark-900) 0%,
          color-mix(in srgb, var(--dark-900) 70%, transparent) 6%,
          color-mix(in srgb, var(--dark-900) 25%, transparent) 13%,
          transparent 22%
        ),
        radial-gradient(
          70% 45% at 50% 22%,
          color-mix(in srgb, var(--brand-500) 12%, transparent),
          transparent 70%
        );
    }

    /* --------------------------------------------------------------- öffnungs */
    .hours_strip {
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: flex;
      flex-wrap: wrap;
