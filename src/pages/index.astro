---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
import PageHeader from "@/components/PageHeader.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Img from "@/components/Img.astro";
import Eyebrow from "@/components/Eyebrow.astro";
import OpenStatusPill from "@/components/OpenStatusPill.astro";
import Grid from "@/components/Grid.astro";
import Card from "@/components/Card.astro";
import BottleOptions from "@/components/BottleOptions.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import Schema from "@/components/Schema.astro";
import { barSchema } from "@/utils/schema.ts";
import { getHours, getUpcomingEvents, minPriceCHF, bottleFromCHF, getHappyHour, getHomepageGallery, getFeaturedDrinks } from "@/utils/content.ts";
import { eventImage } from "@/utils/eventImage.ts";
import { longDate } from "@/utils/dates.ts";
import { openDaysLabel } from "@/utils/hours.ts";
import { ADDRESS_LINE, BUSINESS } from "@/consts.ts";
import _SCJ5832 from '@/assets/flamingo/_SCJ5832.webp';
import _SCJ6123 from '@/assets/flamingo/_SCJ6123.webp';

/* Öffnungszeiten für das Structured Data — dieselbe Quelle wie die Tabelle. */
const hours = await getHours();

/* Teaser aus denselben Collections, die `/getraenkekarte` und `/events`
   zeigen. Standen hier früher ausgeschrieben im Markup — mit einbetonierten
   Daten ("Freitag, 21. August 2026"), die nach dem Abend nie wieder stimmten,
   und mit Getränketexten, die bei jeder Keystatic-Änderung auseinanderliefen. */

/* Die naechsten drei Abende. Nicht auf Termine mit Bild gefiltert: pflegt
   der Betrieb Termine ohne Bild — heute alle kommenden — bliebe der Teaser
   sonst leer, obwohl Abende anstehen. `eventImage()` liefert je nach Art des
   Abends eines nach, damit jede Karte `cover` samt Overlay tragen kann. */
const teaserEvents = (await getUpcomingEvents()).slice(0, 3);

/* „Ab“-Preise gerechnet, nicht getippt: die Seite behauptete an vier Stellen
   „Cocktails ab CHF 12.–“, während der günstigste Cocktail CHF 14 kostete.
   Jede Zahl hier kommt aus den Preisen, die in Keystatic stehen — der Teaser
   sagt damit nie einen Preis, den es an der Bar nicht gibt. */
const drinkFrom = await minPriceCHF([
  "alkoholfrei",
  "warm",
  "bier",
  "wein",
  "shots",
  "aperitif",
  "likoere",
  "whisky",
  "vodkarum",
]);
const bottleFrom = await bottleFromCHF();

/* Die grossen Karten im Karte-Teaser: die Getränke mit dem Haken
   "Auf der Startseite zeigen". Standen als drei ausgeschriebene Gruppen hier
   ("Bier & Wein", "Spirituosen & Liköre", "Flaschenservice") mit gerechnetem
   Ab-Preis — die Zahlen stimmten, aber welche Drinks es sind, entschied der
   Code. Jetzt entscheidet das die Bar in Keystatic.

   Die Ab-Preise sind darum nicht verloren: sie stehen weiter im Fliesstext
   der Überschrift (`drinkLine`, `bottleLine`). */
const featuredDrinks = await getFeaturedDrinks();

const drinkLine = drinkFrom ? `Drinks ab CHF ${drinkFrom}.–` : "Drinks";
const bottleLine = bottleFrom ? `Flaschen ab CHF ${bottleFrom}.–` : "Flaschenservice";

/* „Do – So, ab 20 Uhr“ aus den Öffnungszeiten statt als Text daneben. */
const openDays = openDaysLabel(hours);

/* Happy Hour aus der Collection — stand im Hinweis unter dem Events-Raster. */
const happyHour = await getHappyHour();

/* Das Bilderband der Startseite — die Galerie-Kacheln mit dem Haken
   "Auch auf der Startseite zeigen". Standen als vier <Img>-Bloecke im Markup,
   samt zweitem Satz Alt-Texte, die von denen der Galerie schon abwichen. */
const marqueeTiles = await getHomepageGallery();
const happyHourNote = happyHour
  ? `Jede Woche: Happy Hour am ${happyHour.label}.`
  : "";
---

<Layout
  title="Bar in Langenthal – Drinks & DJs"
  description={`Flamingo Bar an der ${BUSINESS.street} in ${BUSINESS.city}: ${drinkLine}, DJ-Abende, Live-Musik und Flaschenservice. ${openDays} offen.`}
  theme="dark"
>
  <Schema slot="head" data={barSchema(hours)} />
  <script is:inline slot="head">
    // Blendet den Hero vor dem ersten Paint aus, damit die Ladeanimation nicht
    // ruckelt. Ohne JS oder bei prefers-reduced-motion passiert nichts – die
    // Klasse wird nie gesetzt und der Hero ist von Anfang an sichtbar.
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("is-preload");

      // Sicherheitsnetz. Aufgehoben wird der Haltezustand sonst nur vom
      // GSAP-Skript; kommt dessen Bundle nicht an (Netzfehler, CSP, ein
      // Fehler weiter oben im Modulgraph), blieben Subline, beide CTAs, die
      // Status-Pille und die Nav-Pille dauerhaft auf `opacity: 0` — auf der
      // wichtigsten Seite der Site.
      //
      // Läuft GSAP später doch noch an, findet es die Klasse nicht mehr vor
      // und überspringt die Animation. Genau richtig: nach vier Sekunden hat
      // die Seite längst gestanden, eine Einblendung wäre dann ein Zucken.
      setTimeout(function () {
        document.documentElement.classList.remove("is-preload");
      }, 4000);
    }
  </script>
  <!-- HERO -->
  <section class="hero_section">
    <div class="hero_content">
      <OpenStatusPill class="hero_status" />
      <Heading tag="h1" variant="h1" class="hero_heading"
        >Deine Bar in Langenthal <br />für Drinks und lange Nächte</Heading
      >
      <Paragraph class="hero_text">{drinkLine}, Flaschenservice und DJ-Abende. {BUSINESS.street}, {
          BUSINESS.city
        }.</Paragraph
      >
      <ButtonWrapper class="hero_buttons">
        <Button element="link" href="/getraenkekarte"
          >Getränkekarte ansehen</Button
        >
        <Button element="link" href="/reservation" variant="secondary"
          >Tisch anfragen</Button
        >
      </ButtonWrapper>
    </div>
    <div class="hero_visual">
      <Img src={_SCJ5832} alt="Gäste an der Bartheke der Flamingo Bar bei Nacht, Neon-Pink beleuchtet" loading="eager" fetchPriority="high" width={3840} height={2560} />
      <div class="hero_scrim"></div>
    </div>
  </section>
  <!-- ÖFFNUNGSZEITEN -->
  <Section paddingTop="medium" paddingBottom="none" id="oeffnungszeiten">
    <div class="hours_strip measure-main">
      <div class="hours_strip-headline">
        <span class="hours_strip-label">Offen</span>
        <span class="hours_strip-value">{openDays}</span>
      </div>
      <div class="hours_strip-today">
        <span class="hours_strip-pill">
          <span class="hours_strip-pill-label">Heute</span>
          <span data-today-line></span>
        </span>
        <Button element="link" href="/oeffnungszeiten" variant="link"
          >Alle Zeiten</Button
        >
      </div>
    </div>
  </Section>
  <script>
    // Ladeanimation des Heros. Läuft genau einmal pro Seitenaufruf, deshalb
    // darf sie etwas länger sein als eine Interaktions-Animation.
    import { gsap } from "gsap";

    const root = document.documentElement;

    // Die Klasse setzt der Inline-Head-Script nur, wenn animiert werden darf.
    if (root.classList.contains("is-preload")) {
      const image = document.querySelector<HTMLElement>(".hero_visual img");
      const pill = document.querySelector<HTMLElement>(".nav_pill");
      // Die H1 blendet nicht ein, sie wird nur versetzt: sie ist der
      // Text-LCP-Kandidat und muss beim ersten Paint lesbar sein.
      const heading = document.querySelector<HTMLElement>(".hero_heading");
      const fadeItems = [
        document.querySelector<HTMLElement>(".hero_status"),
        document.querySelector<HTMLElement>(".hero_text"),
        document.querySelector<HTMLElement>(".hero_buttons"),
      ].filter((el): el is HTMLElement => el !== null);

      const img = image as HTMLImageElement | null;

      // Das Bild kommt zuletzt: erst steht der Text, dann blendet das Foto
      // darunter auf. Läuft als eigener Tween, damit der Text nicht auf den
      // Decode warten muss — sonst hinge die ganze Animation am Netz.
      //
      // Der Scrim (`.hero_scrim`) bleibt aussen vor: der Verlauf ist von
      // Anfang an da und steht die ganze Animation über still.
      let imageRevealed = false;
      const revealImage = () => {
        if (imageRevealed) return;
        imageRevealed = true;

        gsap.to(image, {
          opacity: 1,
          duration: 1.1,
          ease: "power3.out",
          // Siehe `reveal()` weiter unten: `"all"` würde das ganze
          // style-Attribut leeren. Hier stand bisher nichts drin, was das
          // gestört hätte — die Falle bleibt trotzdem dieselbe.
          clearProps: "opacity",
        });
      };

      // Aufblenden erst, wenn Text fertig ist *und* das Bild da ist. Fehlt
      // eines von beidem, wartet die andere Seite.
      let textDone = false;
      let imageReady = !img || img.complete;
      const maybeRevealImage = () => {
        if (textDone && imageReady) revealImage();
      };

      if (img && !img.complete) {
        const onReady = () => {
          imageReady = true;
          maybeRevealImage();
        };
        img.addEventListener("load", onReady, { once: true });
        img.addEventListener("error", onReady, { once: true });
      }

      const start = () => {
        // Erst freigeben, wenn GSAP die Startwerte gesetzt hat.
        gsap.set(fadeItems, { opacity: 0, y: 14, force3D: true });
        gsap.set(heading, { y: 14, force3D: true });
        // Das Bild blendet nur auf und steht dabei still: kein Zoom, kein
        // Versatz. Der Haltezustand unten setzt es vorab auf `opacity: 0`,
        // sonst stünde es zwischen Decode und Skriptstart schon sichtbar da
        // und würde beim Start der Animation wieder verschwinden.
        gsap.set(image, { opacity: 0 });
        gsap.set(pill, { opacity: 0, y: -12, force3D: true });
        root.classList.remove("is-preload");

        const tl = gsap.timeline({
          defaults: { ease: "power3.out" },
          onComplete: () => {
            gsap.set([heading, ...fadeItems, pill], { clearProps: "opacity,transform" });
            textDone = true;
            maybeRevealImage();
          },
        });

        tl.to(heading, { y: 0, duration: 0.6 })
          .to(
            fadeItems,
            { opacity: 1, y: 0, duration: 0.6, stagger: 0.06 },
            "<",
          )
          .to(pill, { opacity: 1, y: 0, duration: 0.5 }, "<0.1");
      };

      // Der Text wartet auf nichts — er startet, sobald das Skript läuft.
      start();
    }
  </script>
  <script>
    // Scroll-Reveals für Sections, Listen und Karten. Jede Gruppe läuft genau
    // einmal – wer zurückscrollt, soll nicht dieselbe Show nochmal sehen.
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.registerPlugin(ScrollTrigger);

      // Sichtbar ab 15 % Einblendung – früh genug, dass die Bewegung schon
      // fast fertig ist, wenn das Element in der Blickmitte ankommt.
      const reveal = (
        selector: string,
        options: { stagger?: number; y?: number; scale?: number } = {},
      ) => {
        const targets = gsap.utils.toArray<HTMLElement>(selector);
        if (!targets.length) return;

        targets.forEach((target) => {
          const children = options.stagger
            ? gsap.utils.toArray<HTMLElement>(target.children)
            : [target];
          if (!children.length) return;

          gsap.from(children, {
            opacity: 0,
            y: options.y ?? 16,
            scale: options.scale ?? 1,
            duration: 0.6,
            ease: "power3.out",
            stagger: options.stagger ?? 0,
            force3D: true,
            /* Nur die eigenen Spuren wegräumen, nicht das ganze Attribut.
               `clearProps: "all"` setzt in GSAP `style.cssText = ""` und
               löscht damit auch Custom Properties, die GSAP nie angefasst
               hat. `Card.astro` schreibt `--_cover-ratio`,
               `--_cover-min-height` und `--_content-align` genau dorthin:
               nach dem Einblenden verlor eine Karte ihr Seitenverhältnis
               (`aspect-ratio: auto`) und ihre Ausrichtung sprang von unten
               nach oben zurück auf `flex-start`.

               `transform` deckt auch `translate`/`rotate`/`scale` ab — GSAP
               räumt die im selben Zweig mit auf. Weg müssen sie, weil ein
               Inline-`transform` sonst den Hover-Effekt der Karte schlägt. */
            clearProps: "opacity,transform",
            scrollTrigger: { trigger: target, start: "top 85%", once: true },
          });
        });
      };

      // Überschrift, Subline und CTA einer Section laufen gestaffelt ein.
      reveal(".section-header", { stagger: 0.07 });
      // Karten und Listen: gleiche Staffelung, damit die Seite einen Takt hat.
      reveal(".menu_grid", { stagger: 0.08, y: 24 });
      reveal(".events_grid", { stagger: 0.08, y: 24 });
      reveal(".bottle_options", { stagger: 0.08 });
      reveal(".visit_details", { stagger: 0.08 });
      // Grossflächige Bilder blenden ohne Versatz, nur mit leichtem Zoom ein.
      reveal(".bottle_visual", { y: 0, scale: 1.03 });
      reveal(".visit_map", { y: 0, scale: 1.03 });
      reveal(".gallery_marquee", { y: 0 });
      reveal(".events_note", {});
      reveal(".gallery_note", { stagger: 0.07 });
    }
  </script>
  <!-- KARTE-TEASER -->
  <Section paddingTop="medium" paddingBottom="large" align="center" id="karte">
    <PageHeader
      headingTag="h2"
      maxWidth={40}
      text={`${drinkLine}, ${bottleLine}. Alle Preise stehen online, nicht nur auf der Tafel an der Bar.`}
    >
      <Fragment slot="heading">Was im Glas<br />landet</Fragment>
      <ButtonWrapper>
        <Button element="link" href="/getraenkekarte"
          >Ganze Karte ansehen</Button
        >
      </ButtonWrapper>
    </PageHeader>
    {/* `cover` legt den Verlauf ueber das Foto, damit Preis und Name darauf
         lesbar bleiben. Der Preis steht als Eyebrow: er ist die Zahl, wegen
         der jemand hinsieht, und er kommt aus derselben Zeile der Karte wie
         auf `/getraenkekarte`. */}
    <Grid medium={3} class="menu_grid" render={featuredDrinks.length > 0}>
      {
        featuredDrinks.map((drink) => (
          <Card variant="cover" image={drink.data.image} imageAlt={drink.data.imageAlt} eyebrow={drink.data.price} heading={drink.data.name} headingTag="h3" text={drink.data.description ?? drink.data.note} ratio="3 / 4" contentAlign="end" />
        ))
      }
    </Grid>
  </Section>
  <!-- WAS LÄUFT -->
  <Section paddingTop="medium" paddingBottom="large" align="center" id="events">
    <PageHeader
      headingTag="h2"
      maxWidth={40}
      text="DJ-Abende, Live-Musik und Motto-Partys."
    >
      <Fragment slot="heading">Was diese Woche<br />läuft</Fragment>
      <ButtonWrapper>
        <Button element="link" href="/events" variant="secondary"
          >Alle Events</Button
        >
      </ButtonWrapper>
    </PageHeader>
    <div class="events_content">
      <Grid medium={3} class="events_grid alignment-start" render={teaserEvents.length > 0}>
        {
          teaserEvents.map((item) => (
            <Card variant="cover" {...eventImage(item.data)} eyebrow={longDate(item.data.start)} heading={item.data.name} ratio="3 / 4" contentAlign="end" cardTag="article" />
          ))
        }
      </Grid>
      <Paragraph variant="small" class="section-note events_note margin-top-6">
        {happyHourNote} Sportübertragungen auf Anfrage. Eintritt frei — ausser
        an ausgewählten Events mit Live-Musik.
      </Paragraph>
    </div>
  </Section>
  <!-- ATMOSPHÄRE -->
  <Section
    paddingTop="medium"
    paddingBottom="large"
    align="center"
    id="atmosphaere"
  >
    <PageHeader headingTag="h2" maxWidth="none" text="Wir freuen uns, euch bei uns zu begrüssen — mit einer grossen Auswahl an Getränken in entspannter Atmosphäre.">
      <Fragment slot="heading">Licht, Musik<br />und späte Stunden</Fragment>
    </PageHeader>
  </Section>
  {/* Das Band laeuft endlos: `gallery-scroll` schiebt die Spur um `-50%`,
       also genau um einen Durchgang. Dafuer steht jede Kachel zweimal da —
       der zweite Satz ist reine Deko und deshalb `aria-hidden`, sonst laese
       ein Screenreader jedes Bild doppelt vor. Weil die Verschiebung
       prozentual ist, stimmt sie bei jeder Anzahl. */}
  {marqueeTiles.length > 0 && (
    <div class="gallery_marquee">
      <div class="gallery_track">
        {marqueeTiles.map((tile) => (
          <div class="gallery_item">
            <Img src={tile.image} alt={tile.alt} />
          </div>
        ))}
        {marqueeTiles.map((tile) => (
          <div class="gallery_item" aria-hidden="true">
            <Img src={tile.image} alt="" />
          </div>
        ))}
      </div>
    </div>
  )}
  <Section paddingTop="small" paddingBottom="medium" align="center">
    <div class="gallery_note">
      <Paragraph variant="small"
        >Mehr Bilder in der <a href="/galerie">Galerie</a>, kurzfristige
        Ankündigungen laufen auf Instagram, Facebook und TikTok — überall als
        Flamingo Bar Langenthal.</Paragraph
      >
      <Button element="link" href={BUSINESS.instagram} variant="link"
        >{BUSINESS.instagramHandle}</Button
      >
    </div>
  </Section>
  <!-- FLASCHENSERVICE -->
  <Section paddingTop="medium" paddingBottom="medium" id="flaschenservice">
    <ContentWrapper class="measure-main" column1Class="bottle_visual" variant="columns">
      <Img src={_SCJ6123} variant="constrained" width={3840} height={5760} />
      <Fragment slot="column2">
        <div>
          <Eyebrow>Flaschenservice</Eyebrow>
          <Heading tag="h2" variant="h2">Eine Flasche<br />an den Tisch</Heading>
        </div>
        <Paragraph maxWidth={34}
          >Die Flasche kommt im Eiskübel mit Wunderkerze an den Tisch, für
          Geburtstage, Gruppen und private Abende. Cola, Red Bull und Mineral
          sind im Flaschenpreis dabei.</Paragraph
        >
        <BottleOptions variant="rows" class="width-full" />
        <ButtonWrapper class="width-full">
          <Button element="link" href="/reservation">Tisch anfragen</Button>
          <Button
            element="link"
            href={`https://wa.me/${BUSINESS.whatsapp}`}
            variant="secondary">WhatsApp</Button
          >
        </ButtonWrapper>
      </Fragment>
    </ContentWrapper>
  </Section>
  <!-- ANFAHRT UND KONTAKT -->
  <Section
    paddingTop="medium"
    paddingBottom="large"
    align="center"
    id="kontakt"
  >
    <PageHeader
      headingTag="h2"
      maxWidth="none"
      heading="Mitten in der Altstadt"
      text="Fünf Minuten zu Fuss vom Bahnhof."
    />
    <Grid medium={3} class="visit_details">
      <div class="visit_detail-item">
        <p class="visit_label text-style-small">Adresse</p>
        <p class="visit_value">{ADDRESS_LINE}</p>
        <Button element="link" href={BUSINESS.mapsUrl} variant="link"
          >Auf Karte öffnen</Button
        >
      </div>
      <div class="visit_detail-item">
        <p class="visit_label text-style-small">Hinweg</p>
        <p class="visit_value">Parkhaus Marktgasse</p>
        <Paragraph variant="small">Bahnhof Langenthal, 5 Minuten</Paragraph>
      </div>
      <div class="visit_detail-item">
        <p class="visit_label text-style-small">Kontakt</p>
        <p class="visit_value">{BUSINESS.phoneDisplay}</p>
        <Paragraph variant="small">WhatsApp für Tischanfragen</Paragraph>
        <Button element="link" href="/kontakt" variant="link"
          >Anfahrt und Kontakt</Button
        >
      </div>
    </Grid>
    <div class="visit_map">
      <MapEmbed />
    </div>
  </Section>
  <!-- FINALER CTA -->
  <Section
    paddingTop="large"
    paddingBottom="large"
    align="center"
    class="cta_section"
  >
    <div class="cta_glow"></div>
    <PageHeader
      headingTag="h2"
      text="Karte, Preise und Flaschenservice, immer aktuell."
    >
      <Fragment slot="heading">Heute Abend<br />schon was vor?</Fragment>
      <ButtonWrapper>
        <Button element="link" href="/getraenkekarte"
          >Getränkekarte ansehen</Button
        >
        <Button element="link" href={BUSINESS.instagram} variant="secondary"
          >Instagram folgen</Button
        >
      </ButtonWrapper>
    </PageHeader>
  </Section>
</Layout>
<style is:global>
  @layer components {
    /* Haltezustand der Ladeanimation: gilt nur, solange das Head-Script die
       Klasse gesetzt hat, also nie ohne JS und nie bei reduzierter Bewegung. */
    /* Die H1 ist der Text-LCP-Kandidat und wird nie ausgeblendet — sie kommt
       nur per Transform herein. Das Hero-Bild blendet dagegen auf und steht
       deshalb hier mit: ohne den Haltezustand blitzt es zwischen Decode und
       Skriptstart auf und verschwindet dann wieder. Der Preis dafür ist, dass
       der Largest Contentful Paint am Bild an der Ausführung von GSAP hängt;
       das Sicherheitsnetz im Head-Skript nimmt die Klasse nach vier Sekunden
       in jedem Fall wieder weg. */
    .is-preload .hero_status,
    .is-preload .hero_text,
    .is-preload .hero_buttons,
    .is-preload .hero_visual img {
      opacity: 0;
    }

    /* ------------------------------------------------------------------- hero */
    .hero_section {
      position: relative;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .hero_content {
      position: relative;
      z-index: 1;
      padding-top: 9.5rem;
      padding-bottom: 1rem;
      padding-inline: var(--site-margin);
      text-align: center;
      flex: 0 0 auto;
    }


    .hero_heading {
      max-width: 46rem;
      margin-inline: auto;
    }

    /* Das Mass steht in `rem`, nicht in `ch`. `ch` misst die Laufweite der
       Null der geladenen Schrift — solange Manrope mit `font-display: swap`
       noch fehlt, gilt die der Fallback-Schrift, und beim Wechsel springt die
       Kappung (181px → 176px) und der Absatz bricht neu um. Genau das war
       der Sprung von drei auf vier Zeilen beim Laden. `24rem` ist ausserdem
       der Wert aus dem Mockup (`.max-width-small`); `18ch` waren 176px und
       damit weniger als die Hälfte davon. */
    .hero_text {
      max-width: 24rem;
      margin-inline: auto;
      margin-top: var(--space-3);
      margin-bottom: var(--space-5);
      color: var(--text-faded);
    }

    .hero_buttons {
      justify-content: center;
    }

    /* Das Bild ist ein eigener Block unter dem Text und rutscht mit negativem
       margin-top darunter. Dadurch ist die Section höher als der Viewport und
       das Bild trägt den Scroll. Der Scrim oben blendet es unter der Headline
       aus. */
    .hero_visual {
      position: relative;
      inset: auto;
      z-index: 0;
      width: 100%;
      height: 100svh;
      margin-top: -13svh;
      overflow: hidden;
    }

    .hero_visual img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 60%;
    }

    .hero_scrim {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to bottom,
          var(--dark-900) 0%,
          color-mix(in srgb, var(--dark-900) 82%, transparent) 6%,
          color-mix(in srgb, var(--dark-900) 34%, transparent) 14%,
          transparent 24%
        ),
        linear-gradient(
          to top,
          var(--dark-900) 0%,
