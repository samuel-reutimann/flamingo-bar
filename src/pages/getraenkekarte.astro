---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/PageHeader.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Grid from "@/components/Grid.astro";
import Card from "@/components/Card.astro";
import aperolImage from "@/assets/flamingo/drink-aperol-spritz.jpeg";
import longIslandImage from "@/assets/flamingo/drink-long-island.jpeg";
import pinaColadaImage from "@/assets/flamingo/drink-pina-colada.jpeg";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, menuSchema } from "@/utils/schema.ts";
import { MENU_SECTIONS } from "@/data/menu.ts";
import { BUSINESS } from "@/consts.ts";

/** Stand der Preise. Beim Aktualisieren der Karte hier mitziehen. */
const PRICE_DATE = "18. August 2026";
/** Derselbe Stand für `Menu.dateModified`, das ein ISO-Datum braucht. */
const PRICE_DATE_ISO = "2026-08-18";
---

<Layout
