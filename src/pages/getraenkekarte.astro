---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/PageHeader.astro";
import Paragraph from "@/components/Paragraph.astro";
import Heading from "@/components/Heading.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import BottleOptions from "@/components/BottleOptions.astro";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, menuSchema } from "@/utils/schema.ts";
import { getHours, getDrinkGroups, getBottleService, getMenuSection, getPriceDate, bottleFromCHF, minPriceCHF } from "@/utils/content.ts";
import { openDaysLabel } from "@/utils/hours.ts";
import { DRINK_CATEGORIES } from "@/content/options.ts";
import { BUSINESS, SITE_LOCALE } from "@/consts.ts";

/* Die Karte kommt aus den Collections `drinks` und `menu-sections` — der
   Betrieb pflegt sie in Keystatic. Die Abschnitte stehen nicht hier im
   Markup, sondern kommen aus `DRINK_CATEGORIES`: ein neuer Abschnitt in
   `src/content/options.ts` erscheint damit auf der Seite, in den Chips und im
   Structured Data, ohne dass diese Datei angefasst wird.

   `groups` sind die Zwischentitel der gedruckten Karte („Flaschenbier
   (33 cl)“, „Flasche (inkl. Zusatzgetränke)“). Die Gruppe ohne Titel steht
   zuerst — dort, wo die Positionen direkt unter der Überschrift stehen. */
const menu = await Promise.all(
  DRINK_CATEGORIES.map(async (category) => ({
    id: category.value,
    chip: category.label,
    section: await getMenuSection(category.value),
    groups: await getDrinkGroups(category.value),
  }))
);

/* Stufen des Flaschenservice — dieselbe Collection, die Startseite,
   Reservation und das Structured Data unten lesen. */
const bottleSection = await getMenuSection("flaschen");
const bottleTiers = await getBottleService();

/* Öffnungstage für den Schlusssatz — aus der Collection, nicht getippt. */
const openDaysLong = openDaysLabel(await getHours(), { long: true });

/* „Ab“-Preise gerechnet statt getippt: der günstigste feste Preis der ganzen
   Karte und der günstigste Flaschenpreis. */
const drinkFrom = await minPriceCHF(DRINK_CATEGORIES.map((c) => c.value));
const bottleFrom = await bottleFromCHF();

const drinkLine = drinkFrom ? `Drinks ab CHF ${drinkFrom}.–` : "Alle Drinks";
const bottleLine = bottleFrom
  ? `Flaschen ab CHF ${bottleFrom}.–`
  : "Flaschenservice";

/** Stand der Preise. ISO für `Menu.dateModified`, ausgeschrieben für die Seite. */
const priceDateIso = (await getPriceDate()) ?? "";
const priceDate = priceDateIso
  ? new Intl.DateTimeFormat(SITE_LOCALE, {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "Europe/Zurich",
    }).format(new Date(priceDateIso))
  : "";

/* Structured Data aus denselben Einträgen. `price` ist dort der reine Betrag
   ohne Währung, deshalb `priceCHF` statt des Anzeigetexts — und nur, wo der
   Preis wirklich fest ist. Der Klammerzusatz („4.8%“, „Lemon / Peach“) ist
   für Google die Beschreibung der Position. */
type DrinkEntries = (typeof menu)[number]["groups"][number]["entries"];

const toMenuItems = (entries: DrinkEntries) =>
  entries.map((drink) => {
    const description = drink.data.description ?? drink.data.note;
    return {
      name: drink.data.name,
      ...(description ? { description } : {}),
      ...(drink.data.priceCHF !== undefined
        ? { price: String(drink.data.priceCHF) }
        : {}),
    };
  });

const menuSections = [
  ...menu.map(({ section, groups }) => {
    const named = groups.filter((group) => group.label);
    return {
      name: section.title,
      description: [section.intro, section.note].filter(Boolean).join(" ") || undefined,
      items: toMenuItems(
        groups.find((group) => !group.label)?.entries ?? []
      ),
      ...(named.length
        ? {
            sections: named.map((group) => ({
              name: group.label!,
              items: toMenuItems(group.entries),
            })),
          }
        : {}),
    };
  }),
  {
    name: bottleSection.title,
    description: bottleSection.intro,
    items: bottleTiers.map((tier) => ({
      name: tier.data.name,
      description: [tier.data.description, tier.data.price]
        .filter(Boolean)
        .join(". "),
    })),
  },
];
---

<Layout
  title="Getränkekarte mit Preisen – Langenthal"
  description={`Die ganze Karte der Flamingo Bar Langenthal mit allen Preisen: Bier, Wein, Whisky, Vodka, Liköre und alkoholfreie Getränke. ${drinkLine}, ${bottleLine}.`}
  theme="dark"
>
  <Schema
    slot="head"
    data={[
      menuSchema(menuSections, priceDateIso),
      breadcrumbSchema([{ name: "Getränkekarte", path: "/getraenkekarte" }]),
    ]}
  />
  <Section paddingTop="navoverlap" paddingBottom="small" align="center">
    <PageHeader
      heading="Getränkekarte"
      text={`Alle Preise stehen hier, nicht nur auf der Tafel an der Bar. Aktualisiert am ${priceDate}.`}
    />
  </Section>

  {/* Sprungnavigation: am Tisch soll niemand die ganze Karte durchscrollen.
       Die Chips bleiben beim Scrollen unter der Nav kleben. */}
  <nav class="chips_wrap" aria-label="Kategorien">
    <ul class="chips measure-main">
      {
        menu.map((category) => (
          <li>
            <a class="chip" href={`#${category.id}`}>
              {category.chip}
            </a>
          </li>
        ))
      }
      <li><a class="chip" href="#flaschen">Flaschenservice</a></li>
    </ul>
  </nav>

  {
    menu.map((category, index) => (
      <Section
        paddingTop={index === 0 ? "medium" : "none"}
        paddingBottom="large"
        align="center"
        id={category.id}
      >
        <PageHeader
          headingTag="h2"
          variant="h3"
          heading={category.section.title}
          text={category.section.intro}
        />
        {category.groups.map((group) => (
          <>
            <Heading
              tag="h3"
              variant="inherit"
              class="drink_group"
              render={Boolean(group.label)}
            >
              {group.label}
            </Heading>
            <ul class="drink_list">
              {group.entries.map((drink) => (
                <li class="drink_row">
                  <span class="drink_name">
                    {drink.data.name}
                    {drink.data.note && (
                      <span class="drink_note"> ({drink.data.note})</span>
                    )}
                  </span>
                  <span class="drink_dots" />
                  <span class="drink_price">{drink.data.price}</span>
                </li>
              ))}
            </ul>
          </>
        ))}
        <Paragraph
          variant="small"
          maxWidth={32}
          class="section-note drink_footnote"
          render={Boolean(category.section.note)}
        >
          {category.section.note}
        </Paragraph>
      </Section>
    ))
  }

  <Section paddingTop="none" paddingBottom="large" align="center" id="flaschen">
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={bottleSection.title}
      text={bottleSection.intro}
    />
    <BottleOptions class="margin-bottom-6" />
    <ButtonWrapper>
      <Button element="link" href="/reservation/">Tisch anfragen</Button>
      <Button
        element="link"
        href={`https://wa.me/${BUSINESS.whatsapp}`}
        variant="secondary">WhatsApp</Button
      >
    </ButtonWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="medium" align="center">
    <div class="menu_note">
      <p class="menu_note-label text-style-small">Hinweise</p>
      <Paragraph variant="small" maxWidth={52} class="section-note">
        Preise aktualisiert am {priceDate}. «Auf Anfrage» heisst: der Preis
        hängt von der Sorte oder der Menge ab, wir sagen ihn dir vor der
        Bestellung. Einzelne Sorten können ausgehen — dann nennen wir eine
        Alternative. Die Prozentangaben sind der Alkoholgehalt.
      </Paragraph>
    </div>
  </Section>

  <Section paddingTop="none" paddingBottom="large" align="center">
    <PageHeader
      headingTag="h2"
      variant="h3"
      maxWidth="none"
      heading="Heute Abend hier?"
      text={`${openDaysLong}, ${BUSINESS.street}.`}
    >
      <ButtonWrapper>
        <Button element="link" href="/reservation/">Tisch anfragen</Button>
        <Button element="link" href="/events/" variant="secondary"
          >Events ansehen</Button
        >
      </ButtonWrapper>
    </PageHeader>
  </Section>
</Layout>

<script>
  // Markiert den Chip der Kategorie, die gerade im Blick ist, und schiebt ihn
  // in der Leiste mit. Gerechnet statt beobachtet: die Kategorie, deren
  // Abschnitt die Messlinie knapp unter der Chip-Leiste schneidet, gilt als
  // aktuell. Ohne JS bleiben die Chips reine Sprunglinks.
  const chips = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".chip"),
  );

  const entries = chips
    .map((chip) => {
      const section = document.querySelector<HTMLElement>(
        chip.getAttribute("href") ?? "",
      );
      return section ? { chip, section } : null;
    })
    .filter(
      (entry): entry is { chip: HTMLAnchorElement; section: HTMLElement } =>
        entry !== null,
    );

  // Die Chip-Leiste selbst — sie ist der einzige Container, der scrollen darf.
  const bar = chips[0]?.closest<HTMLElement>(".chips");
  let lastIndex = -1;

  if (entries.length) {
    const update = () => {
      // Messlinie: ein Drittel unter dem oberen Rand, also unterhalb der Chips.
      const line = window.innerHeight / 3;
      let currentIndex = -1;

      entries.forEach((entry, index) => {
        if (entry.section.getBoundingClientRect().top <= line)
          currentIndex = index;
      });

      entries.forEach((entry, index) => {
        const isCurrent = index === currentIndex;
        entry.chip.classList.toggle("is-current", isCurrent);
        entry.chip.setAttribute("aria-current", isCurrent ? "true" : "false");
      });

      if (currentIndex === lastIndex) return;
      lastIndex = currentIndex;

      // Die Leiste selbst nachführen, nicht die Seite: `scrollIntoView` würde
      // die ganze Vorfahrenkette durchgehen und könnte aus dem Scroll-Handler
      // heraus die Seite mitscrollen. `scrollLeft` rührt nur die Leiste an.
      const chip = entries[currentIndex]?.chip;
      if (!chip || !bar) return;
      const target =
        chip.offsetLeft - (bar.clientWidth - chip.offsetWidth) / 2;
      bar.scrollTo({
        left: Math.max(0, target),
        behavior: "instant" as ScrollBehavior,
      });
    };

    // Zehn Messungen pro Scroll-Event, direkt im Handler: billiger als das
    // Umschalten selbst, und ohne rAF bleibt die Leiste beim schnellen Scrollen
    // nicht hinter dem Inhalt zurück.
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>

<style is:global>
  @layer components {
    /* ------------------------------------------------------------------ chips */
    .chips_wrap {
      position: sticky;
      top: calc(var(--nav-height) + 0.5rem);
      z-index: 5;
      width: 100%;
      padding-inline: var(--site-margin);
      /* Hinter den Chips soll die Seite nicht durchscheinen. */
      background: linear-gradient(
        to bottom,
        var(--background) 55%,
        color-mix(in lab, var(--background) 0%, transparent)
      );
      padding-block: 0.5rem 1rem;
    }

    .chips {
      display: flex;
      gap: var(--space-2);
      padding: 0 0 0.25rem;
      list-style: none;
      overflow-x: visible;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .chips::-webkit-scrollbar {
      display: none;
    }

    /* Ab dieser Breite passen alle Chips in eine Zeile, dann sitzen sie zentriert
       wie der Rest der Seite. Schmaler bleibt die Leiste linksbündig, sonst
       verschwindet der erste Chip hinter dem Rand. */
    @media (min-width: 64rem) {
      .chips {
        justify-content: center;
      }
    }

    .chip {
      display: inline-block;
      padding: 0.5rem 0.9rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      background-color: color-mix(in lab, var(--text) 4%, transparent);
      color: var(--text);
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      white-space: nowrap;
      scroll-snap-align: center;
      transition:
        border-color 200ms,
        background-color 200ms,
        color 200ms;
    }

    @media (hover: hover) {
      .chip:hover {
        border-color: color-mix(in lab, var(--brand-500) 50%, transparent);
      }
    }

    .chip.is-current {
      border-color: var(--brand-500);
      background-color: color-mix(in srgb, var(--brand-500) 12%, transparent);
      color: var(--brand-500-soft);
    }

    /* Sprungziel nicht unter der Chip-Leiste verstecken. */
    .section[id] {
      scroll-margin-top: calc(var(--nav-height) + 4rem);
    }

    /* ------------------------------------------------------------- drink list */
    .drink_list {
      display: grid;
      gap: 0.25rem;
      max-width: 32rem;
      margin: 0 auto;
      list-style: none;
      padding: 0;
      text-align: left;
    }

    /* Drei Spalten statt Flexbox: der Klammerzusatz („Green 17%, Red 24%, …“)
       ist manchmal länger als der Name, und nur eine Spalte, die auf 0
       schrumpfen darf, lässt ihn umbrechen statt die Zeile zu sprengen. Die
       Punktreihe behält ihr Minimum, damit sie nicht verschwindet. */
    .drink_row {
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(1.5rem, 1fr) auto;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.7rem 1.25rem;
      border-radius: var(--radius-small);
    }

    .drink_name {
      font-family: var(--display-family);
      font-size: 1.0625rem;
    }

    /* Volumenprozent, Größe oder Sorten — mitlesbar, aber nicht mitlaut. */
    .drink_note {
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.03em;
      color: var(--text-faded);
      white-space: normal;
    }

    .drink_dots {
      border-bottom: var(--border-width) dotted
        color-mix(in srgb, var(--light-100) 20%, transparent);
      transform: translateY(-0.3rem);
    }

    .drink_price {
      font-family: var(--mono-family);
      font-size: 0.75rem;
      letter-spacing: 0.05em;
      color: var(--brand-500);
      white-space: nowrap;
    }

    /* Zwischentitel innerhalb eines Abschnitts: „Flaschenbier (33 cl)“. */
    .drink_group {
      max-width: 32rem;
      margin: 0 auto 0.35rem;
      padding-inline: 1.25rem;
      font-family: var(--mono-family);
      font-size: 0.625rem;
      font-weight: var(--primary-regular);
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: var(--brand-500);
      text-align: left;
    }

    /* Abstand bekommt nur ein Zwischentitel, über dem schon eine Liste steht
       — nicht der erste unter der Einleitung. `:first-of-type` ginge hier
       nicht: in Whisky und Vodka steht die erste Liste ohne Zwischentitel, der
       erste `h3` des Abschnitts folgt dort also auf eine Liste. */
    .drink_list + .drink_group {
      margin-top: var(--space-5);
    }

    /* Die Fußnote der gedruckten Karte: „Mischgetränk: + CHF 3.–“. */
    .drink_footnote {
      margin-top: var(--space-4);
    }

    @media (max-width: 30rem) {
      .drink_row {
        padding-inline: 0.75rem;
      }

      .drink_group {
        padding-inline: 0.75rem;
      }
    }

    /* ------------------------------------------------------------------ note */
    .menu_note {
      max-width: 44rem;
      margin-inline: auto;
      padding: var(--space-4) var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: color-mix(in lab, var(--text) 2%, transparent);
    }

    .menu_note-label {
      font-family: var(--mono-family);
      font-size: 0.5625rem;
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: var(--brand-500);
      margin-bottom: var(--space-2);
    }
  }
</style>
