---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/PageHeader.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Grid from "@/components/Grid.astro";
import Card from "@/components/Card.astro";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, menuSchema } from "@/utils/schema.ts";
import {
  getHours,
  getDrinksByCategory,
  getSpiritsByGroup,
  getBottleService,
  getMenuSection,
  getPriceDate,
  minPriceCHF,
} from "@/utils/content.ts";
import { openDaysLabel } from "@/utils/hours.ts";
import { BUSINESS, SITE_LOCALE } from "@/consts.ts";

/* Karte aus den Collections `drinks`, `spirits` und `menu-sections` — der
   Betrieb pflegt sie in Keystatic. Früher stand jede Position zweimal da
   (Markup plus eine Zweitfassung für Structured Data); beides liest jetzt
   dieselben Dateien. */
const cocktails = await getDrinksByCategory("cocktails");
const longdrinks = await getDrinksByCategory("longdrinks");
const alkoholfrei = await getDrinksByCategory("alkoholfrei");
const weitere = await getDrinksByCategory("weitere");

/* Cocktails mit Bild stehen oben als Karten, der Rest in der Preisliste. */
const cocktailCards = cocktails.filter((drink) => drink.data.image);
const cocktailRows = cocktails.filter((drink) => !drink.data.image);

/* Stufen des Flaschenservice — dieselbe Collection, die Startseite,
   Reservation und das Structured Data unten lesen. */
const bottleTiers = await getBottleService();

/* Öffnungstage für den Schlusssatz — aus der Collection, nicht getippt. */
const openDaysLong = openDaysLabel(await getHours(), { long: true });

const spiritGroups = [
  { label: "Whisky", entries: await getSpiritsByGroup("whisky") },
  { label: "Vodka", entries: await getSpiritsByGroup("vodka") },
  { label: "Rum", entries: await getSpiritsByGroup("rum") },
  { label: "Gin", entries: await getSpiritsByGroup("gin") },
];

const sections = {
  cocktails: await getMenuSection("cocktails"),
  longdrinks: await getMenuSection("longdrinks"),
  spirituosen: await getMenuSection("spirituosen"),
  alkoholfrei: await getMenuSection("alkoholfrei"),
  flaschen: await getMenuSection("flaschen"),
  weitere: await getMenuSection("weitere"),
};

/* „Ab“-Preis gerechnet statt getippt — die Karte behauptete „ab CHF 12.–“,
   während der günstigste Cocktail CHF 14 kostet. */
const cocktailFrom = await minPriceCHF("cocktails");
const cocktailLine = cocktailFrom ? `Cocktails ab CHF ${cocktailFrom}.–` : "Cocktails";

/** Stand der Preise. ISO für `Menu.dateModified`, ausgeschrieben für die Seite. */
const priceDateIso = (await getPriceDate()) ?? "";
const priceDate = priceDateIso
  ? new Intl.DateTimeFormat(SITE_LOCALE, {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "Europe/Zurich",
    }).format(new Date(priceDateIso))
  : "";

/* Structured Data aus denselben Einträgen. `price` ist dort der reine Betrag
   ohne Währung, deshalb `priceCHF` statt des Anzeigetexts — und nur, wo der
   Preis wirklich fest ist. */
const toMenuItems = (entries: typeof cocktails) =>
  entries.map((drink) => ({
    name: drink.data.name,
    ...(drink.data.description ? { description: drink.data.description } : {}),
    ...(drink.data.priceCHF !== undefined
      ? { price: String(drink.data.priceCHF) }
      : {}),
  }));

const menuSections = [
  {
    name: sections.cocktails.title,
    description: sections.cocktails.intro,
    items: toMenuItems(cocktails),
  },
  {
    name: sections.longdrinks.title,
    description: sections.longdrinks.intro,
    items: toMenuItems(longdrinks),
  },
  {
    name: sections.spirituosen.title,
    description: sections.spirituosen.intro,
    items: [],
    sections: spiritGroups.map((group) => ({
      name: group.label,
      items: group.entries.flatMap((spirit) => [
        {
          name: `${spirit.data.name}, 4 cl`,
          ...(spirit.data.glassCHF !== undefined
            ? { price: String(spirit.data.glassCHF) }
            : { description: spirit.data.glass }),
        },
        {
          name: `${spirit.data.name}, Flasche`,
          ...(spirit.data.bottleCHF !== undefined
            ? { price: String(spirit.data.bottleCHF) }
            : { description: spirit.data.bottle }),
        },
      ]),
    })),
  },
  {
    name: sections.alkoholfrei.title,
    description: sections.alkoholfrei.intro,
    items: toMenuItems(alkoholfrei),
  },
  {
    name: sections.flaschen.title,
    description: sections.flaschen.intro,
    items: bottleTiers.map((tier) => ({
      name: tier.data.name,
      description: [tier.data.description, tier.data.price]
        .filter(Boolean)
        .join(". "),
    })),
  },
  {
    name: sections.weitere.title,
    description: sections.weitere.intro,
    items: toMenuItems(weitere),
  },
];
---

<Layout
  title="Getränkekarte mit Preisen – Langenthal"
  description={`Die ganze Karte der Flamingo Bar Langenthal mit allen Preisen: ${cocktailLine}, Longdrinks, Spirituosen, alkoholfreie Drinks und Flaschenservice.`}
  theme="dark"
>
  <Schema
    slot="head"
    data={[
      menuSchema(menuSections, priceDateIso),
      breadcrumbSchema([{ name: "Getränkekarte", path: "/getraenkekarte" }]),
    ]}
  />
  <Section paddingTop="navoverlap" paddingBottom="small" align="center">
    <PageHeader
      heading="Getränkekarte"
      text="Alle Preise stehen hier, nicht nur auf der Tafel an der Bar."
    />
  </Section>

  {
    /* Sprungnavigation: am Tisch soll niemand die ganze Karte durchscrollen.
       Die Chips bleiben beim Scrollen unter der Nav kleben. */
  }
  <nav class="chips_wrap" aria-label="Kategorien">
    <ul class="chips">
      <li><a class="chip" href="#cocktails">Cocktails</a></li>
      <li><a class="chip" href="#longdrinks">Longdrinks</a></li>
      <li><a class="chip" href="#spirituosen">Spirituosen</a></li>
      <li><a class="chip" href="#alkoholfrei">Alkoholfrei</a></li>
      <li><a class="chip" href="#flaschen">Flaschenservice</a></li>
      <li><a class="chip" href="#weitere">Weitere</a></li>
    </ul>
  </nav>

  <Section
    paddingTop="medium"
    paddingBottom="large"
    align="center"
    id="cocktails"
  >
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={sections.cocktails.title}
      text={sections.cocktails.intro}
    />
    <Grid medium={3} class="menu_grid">
      {
        cocktailCards.map((drink) => (
          <Card
            variant="stacked"
            image={drink.data.image}
            imageAlt={drink.data.imageAlt}
            heading={drink.data.name}
            text={drink.data.description}
          />
        ))
      }
    </Grid>
    <ul class="drink_list">
      {
        cocktailRows.map((drink) => (
          <li class="drink_row">
            <span class="drink_name">{drink.data.name}</span>
            <span class="drink_dots" />
            <span class="drink_price">{drink.data.price}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    paddingTop="none"
    paddingBottom="large"
    align="center"
    id="longdrinks"
  >
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={sections.longdrinks.title}
      text={sections.longdrinks.intro}
    />
    <ul class="drink_list">
      {
        longdrinks.map((drink) => (
          <li class="drink_row">
            <span class="drink_name">{drink.data.name}</span>
            <span class="drink_dots" />
            <span class="drink_price">{drink.data.price}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    /* Spirituosen: 4 cl und ganze Flasche in einer Zeile, damit der Sprung
       vom Glas zum Flaschenservice ohne Rechnen sichtbar ist. */
  }
  <Section
    paddingTop="none"
    paddingBottom="large"
    align="center"
    id="spirituosen"
  >
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={sections.spirituosen.title}
      text={sections.spirituosen.intro}
    />
    <div class="price_table">
      <div class="price_head">
        <span>Sorte</span>
        <span>4 cl</span>
        <span>Flasche</span>
      </div>

      {
        spiritGroups.map((group) => (
          <>
            <h3 class="price_group">{group.label}</h3>
            <ul class="price_rows">
              {group.entries.map((spirit) => (
                <li class="price_row">
                  <span class="price_name">{spirit.data.name}</span>
                  <span class="price_value">{spirit.data.glass}</span>
                  <span class="price_value">{spirit.data.bottle}</span>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </div>
  </Section>

  <Section
    paddingTop="none"
    paddingBottom="large"
    align="center"
    id="alkoholfrei"
  >
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={sections.alkoholfrei.title}
      text={sections.alkoholfrei.intro}
    />
    <ul class="drink_list">
      {
        alkoholfrei.map((drink) => (
          <li class="drink_row">
            <span class="drink_name">{drink.data.name}</span>
            <span class="drink_dots" />
            <span class="drink_price">{drink.data.price}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section paddingTop="none" paddingBottom="large" align="center" id="flaschen">
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={sections.flaschen.title}
      text={sections.flaschen.intro}
    />
    <Grid medium={3} class="bottle_options">
      <div class="bottle_option">
        <Heading tag="h3" variant="h6">Flasche mit Mineral</Heading>
        <Paragraph variant="small" class="section-note"
          >Rum, Vodka, Whisky oder Gin</Paragraph
        >
        <p class="bottle_option-price">CHF 105.– bis 150.–</p>
      </div>
      <div class="bottle_option">
        <Heading tag="h3" variant="h6">Flasche mit 2 Zusätzen</Heading>
        <Paragraph variant="small" class="section-note"
          >Zum Beispiel Cola und Red Bull</Paragraph
        >
        <p class="bottle_option-price">Preis auf Anfrage</p>
      </div>
      <div class="bottle_option">
        <Heading tag="h3" variant="h6">Gruppen und Geburtstage</Heading>
        <Paragraph variant="small" class="section-note"
          >Ab 6 Personen, Tisch reserviert</Paragraph
        >
        <p class="bottle_option-price">Auf Anfrage</p>
      </div>
    </Grid>
    <ButtonWrapper>
      <Button element="link" href="/reservation">Tisch anfragen</Button>
      <Button
        element="link"
        href={`https://wa.me/${BUSINESS.whatsapp}`}
        variant="secondary">WhatsApp</Button
      >
    </ButtonWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="medium" align="center" id="weitere">
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading={sections.weitere.title}
      text={sections.weitere.intro}
    />
    <ul class="drink_list">
      {
        weitere.map((drink) => (
          <li class="drink_row">
            <span class="drink_name">{drink.data.name}</span>
            <span class="drink_dots" />
            <span class="drink_price">{drink.data.price}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section paddingTop="none" paddingBottom="medium" align="center">
    <div class="menu_note">
      <p class="menu_note-label text-style-small">Stand der Preise</p>
      <Paragraph variant="small" maxWidth={52} class="section-note">
        Preise aktualisiert am {priceDate}. «Auf Anfrage» heisst: der Preis
        hängt von der Sorte oder der Menge ab, wir sagen ihn dir vor der
        Bestellung. Einzelne Sorten können ausgehen — dann nennen wir eine
        Alternative.
      </Paragraph>
    </div>
  </Section>

  <Section paddingTop="none" paddingBottom="large" align="center">
    <div class="section-header">
      <Heading tag="h2" variant="h3">Heute Abend hier?</Heading>
      <Paragraph variant="main" class="section-note">
        {openDaysLong}, {BUSINESS.street}.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/reservation">Tisch anfragen</Button>
        <Button element="link" href="/events" variant="secondary"
          >Events ansehen</Button
        >
      </ButtonWrapper>
    </div>
  </Section>
</Layout>

<script>
  // Markiert den Chip der Kategorie, die gerade im Blick ist, und schiebt ihn
  // in der Leiste mit. Gerechnet statt beobachtet: die Kategorie, deren
  // Abschnitt die Messlinie knapp unter der Chip-Leiste schneidet, gilt als
  // aktuell. Ohne JS bleiben die Chips reine Sprunglinks.
  const chips = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(".chip"),
  );

  const entries = chips
    .map((chip) => {
      const section = document.querySelector<HTMLElement>(
        chip.getAttribute("href") ?? "",
      );
      return section ? { chip, section } : null;
    })
    .filter(
      (entry): entry is { chip: HTMLAnchorElement; section: HTMLElement } =>
        entry !== null,
    );

  if (entries.length) {
    const update = () => {
      // Messlinie: ein Drittel unter dem oberen Rand, also unterhalb der Chips.
      const line = window.innerHeight / 3;
      let currentIndex = -1;

      entries.forEach((entry, index) => {
        if (entry.section.getBoundingClientRect().top <= line)
          currentIndex = index;
      });

      entries.forEach((entry, index) => {
        const isCurrent = index === currentIndex;
        if (entry.chip.classList.contains("is-current") === isCurrent) return;
        entry.chip.classList.toggle("is-current", isCurrent);
        if (isCurrent)
          entry.chip.scrollIntoView({ block: "nearest", inline: "center" });
      });
    };

    // Sechs Messungen pro Scroll-Event, direkt im Handler: billiger als das
    // Umschalten selbst, und ohne rAF bleibt die Leiste beim schnellen Scrollen
    // nicht hinter dem Inhalt zurück.
    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>

<style is:global>
  .menu_grid {
    margin-bottom: var(--space-6);
  }

  /* ------------------------------------------------------------------ chips */
  .chips_wrap {
    position: sticky;
    top: calc(var(--nav-height) + 0.5rem);
    z-index: 5;
    width: 100%;
    padding-inline: var(--site-margin);
    /* Hinter den Chips soll die Seite nicht durchscheinen. */
    background: linear-gradient(
      to bottom,
      var(--background) 55%,
      color-mix(in lab, var(--background) 0%, transparent)
    );
    padding-block: 0.5rem 1rem;
  }

  .chips {
    display: flex;
    gap: var(--space-2);
    max-width: var(--max-width-main);
    margin: 0 auto;
    padding: 0 0 0.25rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  /* Ab dieser Breite passen alle Chips in eine Zeile, dann sitzen sie zentriert
     wie der Rest der Seite. Schmaler bleibt die Leiste linksbündig, sonst
     verschwindet der erste Chip hinter dem Rand. */
  @media (min-width: 48rem) {
    .chips {
      justify-content: center;
    }
  }

  .chip {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-round);
    background-color: color-mix(in lab, var(--text) 4%, transparent);
    color: var(--text);
    font-family: var(--mono-family);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    scroll-snap-align: center;
    transition:
      border-color 200ms,
      background-color 200ms,
      color 200ms;
  }

  @media (hover: hover) {
    .chip:hover {
      border-color: color-mix(in lab, var(--brand-500) 50%, transparent);
    }
  }

  .chip.is-current {
    border-color: var(--brand-500);
    background-color: rgba(255, 46, 136, 0.12);
    color: var(--brand-500-soft);
  }

  /* Sprungziel nicht unter der Chip-Leiste verstecken. */
  .section[id] {
    scroll-margin-top: calc(var(--nav-height) + 4rem);
  }

  /* ------------------------------------------------------------- drink list */
  .drink_list {
    display: grid;
    gap: 0.25rem;
    max-width: 32rem;
    margin: 0 auto;
    list-style: none;
    padding: 0;
    text-align: left;
  }

  .drink_row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius-small);
  }

  .drink_name {
    font-family: var(--display-family);
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .drink_dots {
    flex: 1 1 auto;
    border-bottom: var(--border-width) dotted rgba(244, 239, 233, 0.2);
    transform: translateY(-0.3rem);
  }

  .drink_price {
    font-family: var(--mono-family);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--brand-500);
    white-space: nowrap;
  }

  /* ------------------------------------------------------------ price table */
  .price_table {
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
    text-align: left;
  }

  .price_head,
  .price_row {
    display: grid;
    grid-template-columns: 1fr 6rem 6rem;
    align-items: baseline;
    gap: 0.75rem;
  }

  .price_head {
    padding: 0 1.25rem 0.6rem;
    border-bottom: var(--border-width) solid var(--border);
    font-family: var(--mono-family);
    font-size: 0.5625rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    color: color-mix(in lab, currentcolor 48%, transparent);
  }

  .price_head > span + span,
  .price_row > .price_value {
    text-align: right;
  }

  .price_group {
    font-family: var(--mono-family);
    font-size: 0.625rem;
    font-weight: var(--primary-regular);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    color: var(--brand-500);
    margin: var(--space-5) 0 0.35rem;
    padding-inline: 1.25rem;
  }

  .price_rows {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .price_row {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-small);
  }

  .price_name {
    font-family: var(--display-family);
    font-size: 1.0625rem;
  }

  .price_value {
    font-family: var(--mono-family);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: color-mix(in lab, currentcolor 65%, transparent);
    white-space: nowrap;
  }

  @media (max-width: 30rem) {
    .price_head,
    .price_row {
      grid-template-columns: 1fr 5rem 5rem;
      padding-inline: 0.75rem;
    }

    .price_group {
      padding-inline: 0.75rem;
    }
  }

  /* --------------------------------------------------------------- bottles */
  .bottle_options {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  .bottle_option {
    display: grid;
    gap: 0.45rem;
    justify-items: center;
  }

  .bottle_option-price {
    font-family: var(--mono-family);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--brand-500);
    margin: 0;
  }

  /* ------------------------------------------------------------------ note */
  .menu_note {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-main);
    background-color: color-mix(in lab, var(--text) 2%, transparent);
  }

  .menu_note-label {
    font-family: var(--mono-family);
    font-size: 0.5625rem;
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
    color: var(--brand-500);
    margin-bottom: var(--space-2);
  }
</style>
