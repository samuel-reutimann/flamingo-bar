---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
---

<Layout
  title="Seite nicht gefunden"
  description="Diese Seite gibt es nicht. Zurück zur Startseite der Flamingo Bar Langenthal."
  overlap={true}
>
  <Section paddingTop="navoverlap" paddingBottom="navoverlap" class="flex-grow">
    <ContentWrapper centered={true}>
      <Heading variant="h3" tag="h1" maxWidth={17}
        >Diese Seite gibt es nicht</Heading
      >
      <Paragraph variant="large" maxWidth={36}
        >Vielleicht ist sie umgezogen, vielleicht ist der Link alt.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="/">Zurück zur Startseite</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
