---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageHero from "@/components/PageHero.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Grid from "@/components/Grid.astro";
import Card from "@/components/Card.astro";
import Img from "@/components/Img.astro";
import bottleImage from "@/assets/flamingo/bottle-service-lounge.jpeg";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, eventsSchema } from "@/utils/schema.ts";
import { getUpcomingEvents, bottleFromCHF, getHappyHour } from "@/utils/content.ts";
import { eventImage } from "@/utils/eventImage.ts";
import { isoWithOffset, longDate, timeNote } from "@/utils/dates.ts";
import { BUSINESS } from "@/consts.ts";
import _SCJ6040 from '@/assets/flamingo/_SCJ6040.webp';

/* Termine aus der Collection `src/content/events` — der Betrieb pflegt sie in
   Keystatic. Vergangene Abende fallen raus, damit weder die Seite noch Google
   abgelaufene Einträge zeigt. */
const events = await getUpcomingEvents();

/* Startpreis aus der Flaschenservice-Collection statt als Text daneben. */
const bottleFrom = await bottleFromCHF();

/* Happy Hour aus der Collection statt als Text im "Jede Woche"-Raster. */
const happyHour = await getHappyHour();
const bottleLine = bottleFrom
  ? `Flaschen ab CHF ${bottleFrom}.–, Rest auf Anfrage`
  : "Auf Anfrage";

/* Oben die hervorgehobenen Abende als Poster, darunter der Rest als Raster.
   Beide sind `cover`-Karten mit Overlay; der Unterschied ist nur das Format.

   Der Haken allein entscheidet. Vorher stand hier `featured && image`, und
   weil kein kommender Termin ein Bild hat, blieb die obere Reihe immer leer.
   `eventImage()` liefert jetzt je nach Art des Abends eines nach.

   Beide Listen werden unten getrennt gerendert. Vorher lief ein einziges
   `events.map()` ueber alles: `featured` und `listed` wurden berechnet und
   nie benutzt, und der Keystatic-Haken "Oben als grosse Karte zeigen" blieb
   damit ohne Wirkung. */
const featured = events.filter((event) => event.data.featured);
const listed = events.filter((event) => !featured.includes(event));
---

<Layout
  title="Events & DJ-Abende in Langenthal"
  description="DJ-Abende, Live-Musik, Motto-Partys, Sportübertragungen und Happy Hour in der Flamingo Bar Langenthal. Alle kommenden Termine und wie du einen Tisch anfragst."
  theme="dark"
>
  <Schema
    slot="head"
    data={[
      ...eventsSchema(
        events.map((event) => ({
          name: event.data.name,
          start: isoWithOffset(event.data.start),
          end: isoWithOffset(event.data.end),
          description: event.data.description,
          image: event.data.image?.src,
          price: String(event.data.priceCHF),
        }))
      ),
      breadcrumbSchema([{ name: "Events", path: "/events" }]),
    ]}
  />
  <PageHero eyebrow="Events" heading="Ein Datum ist ein Grund" text="DJ-Abende, Live-Musik, Motto-Partys, Sportübertragungen und Happy Hour. Eintritt frei, ausser an ausgewählten Events mit Live-Musik. Kurzfristige Ankündigungen laufen auf Instagram, Facebook und TikTok." image={_SCJ6040} imageAlt="Hände am DJ-Mixer, pinker Laserstrahl über der Konsole" glow={false}>
    <ButtonWrapper>
      <Button element="link" href="/reservation/"
        >Tisch für einen Abend anfragen</Button
      >
      <Button element="link" href={BUSINESS.instagram} variant="secondary">
        {BUSINESS.instagramHandle}
      </Button>
    </ButtonWrapper>
  </PageHero>

  <Section paddingTop="small" paddingBottom="large" align="center">
    <PageHeader headingTag="h2" variant="h3" heading="Als Nächstes" />
    {/* Die hervorgehobenen Abende als Poster. Faellt weg, solange kein
         Termin den Haken samt Bild hat. */}
    <Grid medium={3} class="events_grid alignment-start margin-bottom-6" render={featured.length > 0}>
      {
        featured.map((item) => (
          <Card variant="cover" {...eventImage(item.data)} eyebrow={longDate(item.data.start)} heading={item.data.name} text={timeNote(item.data.start, item.data.priceCHF)} cardTag="article" ratio="3 / 4" contentAlign="end" />
        ))
      }
    </Grid>

    {/* Alle uebrigen Termine, ebenfalls `cover`-Karten mit Overlay, nur ohne
         das 3:4-Posterformat der hervorgehobenen.

         Die Beschreibung aus Keystatic kommt nicht mit: sie wiederholt in den
         gepflegten Terminen genau, was `timeNote()` aus Startzeit und
         Eintritt rechnet („Ab 21 Uhr, Eintritt frei.“). */}
    <Grid medium={3} class="events_grid alignment-start margin-bottom-6" render={listed.length > 0}>
      {
        listed.map((item) => (
          <Card variant="cover" {...eventImage(item.data)} eyebrow={longDate(item.data.start)} heading={item.data.name} text={timeNote(item.data.start, item.data.priceCHF)} cardTag="article" contentAlign="end" />
        ))
      }
    </Grid>

    <ButtonWrapper>
      <Button element="link" href="/reservation/"
        >Tisch für diesen Abend anfragen</Button
      >
    </ButtonWrapper>
  </Section>

  {/* Wiederkehrendes braucht keinen Eintrag pro Woche, aber einen festen
       Platz — sonst fragt jeder einzeln nach der Happy Hour. */}
  <Section
    paddingTop="none"
    paddingBottom="large"
    align="center"
    id="jede-woche"
  >
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading="Jede Woche"
      text="Was jede Woche läuft, ohne dass wir es ankündigen."
    />
    <Grid medium={2} large={4} class="weekly_grid">
      {happyHour && (
        <div class="weekly_item">
          <p class="weekly_label text-style-small">{happyHour.day}</p>
          <Heading tag="h3" variant="h6">Happy Hour</Heading>
          <Paragraph variant="small" class="section-note">
            {[`${happyHour.time}.`, happyHour.note].filter(Boolean).join(" ")}
          </Paragraph>
        </div>
      )}
      <div class="weekly_item">
        <p class="weekly_label text-style-small">Freitag und Samstag</p>
        <Heading tag="h3" variant="h6">DJ ab 21 Uhr</Heading>
        <Paragraph variant="small" class="section-note">
          Wechselnde DJs, offen bis 3.30 Uhr, Eintritt frei.
        </Paragraph>
      </div>
      <div class="weekly_item">
        <p class="weekly_label text-style-small">Immer</p>
        <Heading tag="h3" variant="h6">Eintritt frei</Heading>
        <Paragraph variant="small" class="section-note">
          Eintritt kostet nur an ausgewählten Events mit Live-Musik etwas —
          steht dann beim Termin. Sonst kommst du ohne Eintritt herein.
        </Paragraph>
      </div>
      <div class="weekly_item">
        <p class="weekly_label text-style-small">Auf Anfrage</p>
        <Heading tag="h3" variant="h6">Sportübertragungen</Heading>
        <Paragraph variant="small" class="section-note">
          Grosse Spiele zeigen wir, wenn sich genug Leute melden. Schreib uns
          auf WhatsApp, dann sagen wir dir, ob es läuft.
        </Paragraph>
      </div>
    </Grid>
  </Section>

  <Section paddingTop="none" paddingBottom="medium" id="private-events">
    <ContentWrapper
      variant="columns"
      class="measure-main"
      column1Class="private_visual"
    >
      <Img
        src={bottleImage}
        alt="Gäste in der Loge mit Flasche im Eiskübel und Wunderkerze"
      />
      <Fragment slot="column2">
        <PageHeader
          class="width-full"
          heading="Geburtstage und private Abende"
          headingTag="h2"
          variant="h3"
          text="Ab 6 Personen reservieren wir einen Tisch, ab 20 Personen einen eigenen Bereich. Die Flasche kommt im Eiskübel an den Tisch, Cola, Red Bull und Mineral sind im Preis dabei."
        />
        <div class="def_rows private_rows width-full">
          <div class="def_row private_row">
            <span class="private_row-label">Ab wie vielen Personen</span>
            <span class="private_row-value"
              >6 für einen Tisch, 20 für einen Bereich</span
            >
          </div>
          <div class="def_row private_row">
            <span class="private_row-label">Vorlaufzeit</span>
            <span class="private_row-value">Mindestens eine Woche</span>
          </div>
          <div class="def_row private_row">
            <span class="private_row-label">Musik</span>
            <span class="private_row-value"
              >Wunschmusik nach Absprache mit dem DJ</span
            >
          </div>
          <div class="def_row private_row">
            <span class="private_row-label">Preis</span>
            <span class="private_row-value"
              >{bottleLine}</span
            >
          </div>
        </div>
        <ButtonWrapper class="width-full">
          <Button element="link" href="/reservation/">Anfrage senden</Button>
          <Button
            element="link"
            href={`https://wa.me/${BUSINESS.whatsapp}`}
            variant="secondary"
          >
            WhatsApp
          </Button>
        </ButtonWrapper>
      </Fragment>
    </ContentWrapper>
  </Section>

  <Section paddingTop="medium" paddingBottom="large" align="center">
    <PageHeader
      headingTag="h2"
      variant="h3"
      maxWidth="none"
      heading="Kurzfristiges steht auf Social Media"
      text="Zusätzliche Abende, Gästelisten und Absagen kündigen wir auf Instagram, Facebook und TikTok an — überall als Flamingo Bar Langenthal."
    >
      <ButtonWrapper>
        <Button element="link" href={BUSINESS.instagram}>Instagram</Button>
        <Button element="link" href={BUSINESS.facebook} variant="secondary"
          >Facebook</Button
        >
        <Button element="link" href={BUSINESS.tiktok} variant="secondary"
          >TikTok</Button
        >
      </ButtonWrapper>
    </PageHeader>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .event_list {
      display: grid;
      gap: 0.25rem;
      max-width: 34rem;
      margin: 0 auto;
      list-style: none;
      padding: 0;
      text-align: left;
    }

    .event_row {
      display: grid;
      grid-template-columns: 6rem 1fr auto;
      align-items: center;
      gap: 0.9rem;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-small);
    }

    .event_date {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--text-faded);
    }

    .event_title {
      font-family: var(--display-family);
      font-size: 1.0625rem;
    }

    .event_tag {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brand-500);
      white-space: nowrap;
    }

    @media (max-width: 30rem) {
      .event_row {
        grid-template-columns: 1fr auto;
        row-gap: 0.2rem;
      }

      .event_date {
        grid-column: 1 / -1;
      }
    }

    /* ---------------------------------------------------------------- weekly */
    .weekly_grid {
      text-align: center;
    }

    .weekly_item {
      display: grid;
      gap: 0.35rem;
      justify-items: center;
      padding: var(--space-5) var(--space-4);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: color-mix(in lab, var(--text) 2%, transparent);
    }

    .weekly_label {
      font-family: var(--mono-family);
      font-size: 0.5625rem;
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: var(--brand-500);
      margin: 0;
    }

    /* --------------------------------------------------------------- private */
    .private_visual {
      width: 100%;
      border-radius: var(--radius-main);
      overflow: clip;
      height: 100%;
    }

    .private_visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .private_row-label {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-faded);
    }

    .private_row-value {
      font-family: var(--display-family);
      font-size: 1.0625rem;
    }
  }
</style>
