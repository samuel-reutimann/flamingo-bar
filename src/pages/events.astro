---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/PageHeader.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Grid from "@/components/Grid.astro";
import Card from "@/components/Card.astro";
import Img from "@/components/Img.astro";
import bottleImage from "@/assets/flamingo/bottle-service-lounge.jpeg";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, eventsSchema } from "@/utils/schema.ts";
import { getUpcomingEvents, bottleFromCHF } from "@/utils/content.ts";
import { longDate, shortDate, timeNote } from "@/utils/dates.ts";
import { BUSINESS } from "@/consts.ts";

/* Termine aus der Collection `src/content/events` — der Betrieb pflegt sie in
   Keystatic. Vergangene Abende fallen raus, damit weder die Seite noch Google
   abgelaufene Einträge zeigt. */
const events = await getUpcomingEvents();

/* Startpreis aus der Flaschenservice-Collection statt als Text daneben. */
const bottleFrom = await bottleFromCHF();
const bottleLine = bottleFrom
  ? `Flaschen ab CHF ${bottleFrom}.–, Rest auf Anfrage`
  : "Auf Anfrage";

/* Oben die hervorgehobenen Abende als Poster, darunter der Rest als Liste.
   Ohne Bild kann ein Termin keine Karte werden, sonst bliebe der Poster leer. */
const featured = events.filter((event) => event.data.featured && event.data.image);
const listed = events.filter((event) => !featured.includes(event));

---

<Layout
  title="Events & DJ-Abende in Langenthal"
  description="DJ-Abende, Live-Musik, Motto-Partys, Sportübertragungen und Happy Hour in der Flamingo Bar Langenthal. Alle kommenden Termine und wie du einen Tisch anfragst."
  theme="dark"
>
  <Schema
    slot="head"
    data={[
      ...eventsSchema(
        events.map((event) => ({
          name: event.data.name,
          start: event.data.start,
          end: event.data.end,
          description: event.data.description,
          image: event.data.image?.src,
          price: String(event.data.priceCHF),
        }))
      ),
      breadcrumbSchema([{ name: "Events", path: "/events" }]),
    ]}
  />
  <Section paddingTop="navoverlap" paddingBottom="small" align="center">
    <PageHeader
      eyebrow="Events"
      heading="Ein Datum ist ein Grund"
      text="DJ-Abende, Live-Musik, Motto-Partys, Sportübertragungen und Happy Hour. Kurzfristige Ankündigungen laufen auf Instagram."
    >
      <ButtonWrapper>
        <Button element="link" href="/reservation"
          >Tisch für einen Abend anfragen</Button
        >
        <Button element="link" href={BUSINESS.instagram} variant="secondary">
          {BUSINESS.instagramHandle}
        </Button>
      </ButtonWrapper>
    </PageHeader>
  </Section>

  <Section paddingTop="small" paddingBottom="large" align="center">
    <PageHeader headingTag="h2" variant="h3" heading="Als Nächstes" />
    <Grid medium={3} class="events_grid">
      {
        featured.map((event) => (
          <Card
            variant="cover"
            image={event.data.image}
            imageAlt={event.data.imageAlt}
            eyebrow={longDate(event.data.start)}
            heading={event.data.name}
            text={timeNote(event.data.start, event.data.priceCHF)}
            cardTag="article"
          />
        ))
      }
    </Grid>

    <ul class="event_list">
      {
        listed.map((event) => (
          <li class="event_row">
            <span class="event_date">{shortDate(event.data.start)}</span>
            <span class="event_title">{event.data.name}</span>
            <span class="event_tag">{event.data.tag}</span>
          </li>
        ))
      }
    </ul>

    <ButtonWrapper>
      <Button element="link" href="/reservation"
        >Tisch für diesen Abend anfragen</Button
      >
    </ButtonWrapper>
  </Section>

  {
    /* Wiederkehrendes braucht keinen Eintrag pro Woche, aber einen festen
       Platz — sonst fragt jeder einzeln nach der Happy Hour. */
  }
  <Section
    paddingTop="none"
    paddingBottom="large"
    align="center"
    id="jede-woche"
  >
    <PageHeader
      headingTag="h2"
      variant="h3"
      heading="Jede Woche"
      text="Was ohne Ankündigung stattfindet, solange offen ist."
    />
    <Grid medium={3} class="weekly_grid">
      <div class="weekly_item">
        <p class="weekly_label text-style-small">Donnerstag</p>
        <Heading tag="h3" variant="h6">Happy Hour</Heading>
        <Paragraph variant="small" class="section-note">
          20 – 22 Uhr, ausgewählte Cocktails und Longdrinks vergünstigt.
        </Paragraph>
      </div>
      <div class="weekly_item">
        <p class="weekly_label text-style-small">Freitag und Samstag</p>
        <Heading tag="h3" variant="h6">DJ ab 21 Uhr</Heading>
        <Paragraph variant="small" class="section-note">
          Wechselnde DJs, offen bis 4 Uhr, Eintritt frei.
        </Paragraph>
      </div>
      <div class="weekly_item">
        <p class="weekly_label text-style-small">Auf Anfrage</p>
        <Heading tag="h3" variant="h6">Sportübertragungen</Heading>
        <Paragraph variant="small" class="section-note">
          Grosse Spiele zeigen wir, wenn genug Interesse da ist. Kurz melden
          genügt.
        </Paragraph>
      </div>
    </Grid>
  </Section>

  <Section paddingTop="none" paddingBottom="medium" id="private-events">
    <div class="private_layout">
      <div class="private_visual">
        <Img
          src={bottleImage}
          alt="Gäste in der Loge mit Flasche im Eiskübel und Wunderkerze"
        />
      </div>
      <div class="private_text">
        <Heading tag="h2" variant="h3">Geburtstage und private Abende</Heading>
        <Paragraph maxWidth={34} class="section-note">
          Ab 6 Personen reservieren wir einen Tisch, ab 20 Personen einen
          eigenen Bereich. Flaschenservice mit Mineral oder zwei Zusätzen,
          Wunschmusik nach Absprache.
        </Paragraph>
        <div class="private_rows">
          <div class="private_row">
            <span class="private_row-label">Ab wie vielen Personen</span>
            <span class="private_row-value"
              >6 für einen Tisch, 20 für einen Bereich</span
            >
          </div>
          <div class="private_row">
            <span class="private_row-label">Vorlaufzeit</span>
            <span class="private_row-value">Mindestens eine Woche</span>
          </div>
          <div class="private_row">
            <span class="private_row-label">Preis</span>
            <span class="private_row-value"
              >{bottleLine}</span
            >
          </div>
        </div>
        <ButtonWrapper>
          <Button element="link" href="/reservation">Anfrage senden</Button>
          <Button
            element="link"
            href={`https://wa.me/${BUSINESS.whatsapp}`}
            variant="secondary"
          >
            WhatsApp
          </Button>
        </ButtonWrapper>
      </div>
    </div>
  </Section>

  <Section paddingTop="medium" paddingBottom="large" align="center">
    <div class="section-header">
      <Heading tag="h2" variant="h3">Kurzfristiges steht auf Instagram</Heading>
      <Paragraph variant="main" class="section-note">
        Zusätzliche Abende, Gästelisten und Absagen kündigen wir dort an.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href={BUSINESS.instagram}
          >{BUSINESS.instagramHandle}</Button
        >
        <Button element="link" href="/getraenkekarte" variant="secondary">
          Getränkekarte ansehen
        </Button>
      </ButtonWrapper>
    </div>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .events_grid {
      --_alignment: start;
      text-align: start;
      margin-bottom: var(--space-6);
    }

    /* Lumos' Cover-Card ist ein 20rem hoher Kasten mit Inhalt oben. Hier soll
       sie ein hohes Poster sein, Datum und Titel am Fuss über dem Scrim. */
    .events_grid .card_wrap.cover {
      aspect-ratio: 3 / 4;
      min-height: 0;
    }

    .events_grid .card_content {
      justify-content: flex-end;
    }

    .event_list {
      display: grid;
      gap: 0.25rem;
      max-width: 34rem;
      margin: 0 auto;
      list-style: none;
      padding: 0;
      text-align: left;
    }

    .event_row {
      display: grid;
      grid-template-columns: 6rem 1fr auto;
      align-items: center;
      gap: 0.9rem;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-small);
    }

    .event_date {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: color-mix(in lab, currentcolor 48%, transparent);
    }

    .event_title {
      font-family: var(--display-family);
      font-size: 1.0625rem;
    }

    .event_tag {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--brand-500);
      white-space: nowrap;
    }

    @media (max-width: 30rem) {
      .event_row {
        grid-template-columns: 1fr auto;
        row-gap: 0.2rem;
      }

      .event_date {
        grid-column: 1 / -1;
      }
    }

    /* ---------------------------------------------------------------- weekly */
    .weekly_grid {
      text-align: center;
    }

    .weekly_item {
      display: grid;
      gap: 0.35rem;
      justify-items: center;
      padding: var(--space-5) var(--space-4);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: color-mix(in lab, var(--text) 2%, transparent);
    }

    .weekly_label {
      font-family: var(--mono-family);
      font-size: 0.5625rem;
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: var(--brand-500);
      margin: 0;
    }

    /* --------------------------------------------------------------- private */
    .private_layout {
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));
      gap: clamp(2rem, 1.5rem + 2.5vw, 4rem);
      align-items: center;
    }

    .private_visual {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-main);
      overflow: clip;
    }

    .private_visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .private_rows {
      display: grid;
      margin-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
    }

    .private_row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.35rem var(--space-5);
      padding-block: 1rem;
      border-bottom: var(--border-width) solid var(--border);
    }

    .private_row-label {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: color-mix(in lab, currentcolor 48%, transparent);
    }

    .private_row-value {
      font-family: var(--display-family);
      font-size: 1.0625rem;
    }
  }
</style>
