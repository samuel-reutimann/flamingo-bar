---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import ContentWrapper from "@/components/ContentWrapper.astro";
import PageHeader from "@/components/PageHeader.astro";
import HoursTable from "@/components/HoursTable.astro";
import Grid from "@/components/Grid.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import BottleOptions from "@/components/BottleOptions.astro";
import Img from "@/components/Img.astro";
import PageHero from "@/components/PageHero.astro";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema, faqSchema } from "@/utils/schema.ts";
import { getHours } from "@/utils/content.ts";
import { openDaysLabel } from "@/utils/hours.ts";
import { BUSINESS } from "@/consts.ts";
import _SCJ6340 from '@/assets/flamingo/_SCJ6340.webp';
import _SCJ6130 from '@/assets/flamingo/_SCJ6130.webp';

/* Öffnungstage für die FAQ-Antwort — aus der Collection, nicht getippt. */
const openDaysLong = openDaysLabel(await getHours(), { long: true });

/**
 * Ohne Backend geht die Anfrage über WhatsApp: das Skript baut aus den
 * Feldern eine Nachricht und öffnet den Chat. Sobald ein Formular-Endpoint
 * existiert, hier die URL eintragen und das Feld `action` am Formular setzen.
 *
 * Die Nummern kommen aus `BUSINESS`, damit Formular, Links und Structured
 * Data dieselbe Nummer nennen.
 */
const WHATSAPP_NUMBER = BUSINESS.whatsapp;
const PHONE_NUMBER = BUSINESS.phoneDisplay;

/**
 * Structured Data steht hier oben statt inline am `<Schema>`: der Parser des
 * visuellen Editors liest Attribut-Ausdrücke nur eine Klammerebene tief. Ein
 * Objekt-Literal mit `${…}` darin ist eine Ebene zu viel, und die ganze Seite
 * fiel deshalb auf die Codeansicht zurück. Als Konstante bleibt am Tag nur
 * `data={schemaData}` stehen.
 */
const schemaData = [
  faqSchema([
    {
      question: "Wie frage ich einen Tisch an?",
      answer:
        "Über das Formular auf dieser Seite: Name, Telefon, Wunschtermin, Personenzahl und Bemerkung. Die Anfrage geht per WhatsApp raus, alternativ per Telefon.",
    },
    {
      question: "Wann kommt die Antwort?",
      answer: `Am nächsten Öffnungstag, also ${openDaysLong}. Die Anfrage ist erst mit unserer Bestätigung verbindlich.`,
    },
    {
      question: "Ab wie vielen Personen lohnt sich eine Reservation?",
      answer:
        "Ab sechs Personen, ebenso für Flaschenservice, Geburtstage und private Abende.",
    },
  ]),
  breadcrumbSchema([{ name: "Reservation", path: "/reservation" }]),
];
---

<Layout
  title="Tisch reservieren in Langenthal"
  description="Tisch oder Flaschenservice in der Flamingo Bar Langenthal anfragen: fünf Felder, Antwort per WhatsApp oder Telefon am nächsten Öffnungstag. Ohne Anmeldung."
  theme="dark"
>
  <Schema slot="head" data={schemaData} />
  <PageHero eyebrow="Reservation" heading="Tisch anfragen" text={`Fünf Felder, mehr braucht es nicht. Wir antworten am nächsten Öffnungstag: ${openDaysLong}.`} image={_SCJ6340} imageAlt="Hand hält einen Tumbler mit Eiswürfeln an der Bartheke" glow={false} />

  <Section paddingTop="small" paddingBottom="medium">
    <ContentWrapper
      variant="columns"
      class="measure-main align-items-start"
      column1Class="align-self-start"
    >
      <form
        class="form width-full"
        data-reservation-form
        data-whatsapp={BUSINESS.whatsapp}
        novalidate
      >
        <div class="form_field">
          <label class="form_label" for="res-name">Name</label>
          <input
            class="form_input"
            id="res-name"
            name="name"
            type="text"
            autocomplete="name"
            required
          />
        </div>
        <div class="form_field">
          <label class="form_label" for="res-phone">Telefon</label>
          <input
            class="form_input"
            id="res-phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            required
          />
        </div>
        {/* 9rem waren schmaler als das, was ein `datetime-local`-Feld mindestens
            braucht (gemessen 219px): ab rund 400px Breite entstanden zwei
            Spalten, in denen das Datum in die Personen-Spalte lief. 14rem
            lässt die zweite Spalte erst zu, wenn sie das Feld trägt. */}
        <Grid variant="autofit" minColumnWidth={14} class="gap-4">
          <div class="form_field">
            <label class="form_label" for="res-datetime">Datum und Zeit</label>
            <input
              class="form_input"
              id="res-datetime"
              name="datetime"
              type="datetime-local"
              required
            />
          </div>
          <div class="form_field">
            <label class="form_label" for="res-people">Personen</label>
            <input
              class="form_input"
              id="res-people"
              name="people"
              type="number"
              min="1"
              max="60"
              step="1"
              inputmode="numeric"
              required
            />
          </div>
        </Grid>
        <div class="form_field">
          <label class="form_label" for="res-message"
            >Anlass oder Bemerkung</label
          >
          <textarea class="form_input" id="res-message" name="message" rows="4"
          ></textarea>
        </div>
        <p class="form_note text-style-small">
          Wir verwenden deine Angaben nur, um die Anfrage zu beantworten.{" "}
          <a href="/datenschutz/">Datenschutz</a>
        </p>
        <p class="form_note text-style-small">
          Der Knopf öffnet WhatsApp mit deiner Anfrage — abschicken musst du sie
          dort. Die Anfrage ist unverbindlich, verbindlich wird sie erst mit
          unserer Bestätigung.
        </p>
        <ButtonWrapper>
          <Button type="submit">Anfrage senden</Button>
          <Button
            element="link"
            href={`tel:+${WHATSAPP_NUMBER}`}
            variant="secondary"
          >
            {PHONE_NUMBER}
          </Button>
        </ButtonWrapper>
        <p class="form_status" id="res-status" data-form-status role="status">
        </p>
        <noscript>
          <p class="form_note text-style-small">
            Das Formular braucht JavaScript. Schreib uns stattdessen direkt auf
            <a href={`https://wa.me/${WHATSAPP_NUMBER}`}>WhatsApp</a> oder ruf an:
            <a href={`tel:+${WHATSAPP_NUMBER}`}>{PHONE_NUMBER}</a>.
          </p>
        </noscript>
      </form>

      <aside class="reservation_aside width-full" slot="column2">
        <div class="reservation_visual">
          <Img src={_SCJ6130} alt="Gäste in der Loge mit Flasche im Eiskübel und Wunderkerze" width={3840} height={2560} />
        </div>
        <Heading tag="h2" variant="h5">Direkter Weg</Heading>
        <Paragraph variant="small" class="section-note">
          Kurzfristig? WhatsApp erreicht uns auch während des Abends. Unter
          sechs Personen brauchst du nicht zu reservieren — komm einfach vorbei.
          Einlass ab 18, Ausweis mitbringen.
        </Paragraph>
        <ButtonWrapper marginTop="4">
          <Button element="link" href={`https://wa.me/${WHATSAPP_NUMBER}`}
            >WhatsApp</Button
          >
        </ButtonWrapper>
        <div class="reservation_hours">
          <p class="reservation_label text-style-small">Wann wir da sind</p>
          <HoursTable class="max-width-none" />
        </div>
      </aside>
    </ContentWrapper>
  </Section>

  <Section paddingTop="medium" paddingBottom="large" align="center">
    <PageHeader
      headingTag="h2"
      variant="h3"
      maxWidth="none"
      heading="Flaschenservice und Gruppen"
      text="Cola, Red Bull und Mineral sind im Flaschenpreis dabei."
    />
    <BottleOptions />
    <ButtonWrapper>
      <Button element="link" href="/getraenkekarte/" variant="secondary">
        Getränkekarte ansehen
      </Button>
    </ButtonWrapper>
  </Section>
</Layout>

<script>
  // Kein Backend: die Anfrage wird als WhatsApp-Nachricht zusammengesetzt und
  // der Chat geöffnet. Validierung bleibt beim Browser, nur die Meldung ist
  // eigen, damit sie zum Rest der Seite passt.
  const form = document.querySelector<HTMLFormElement>(
    "[data-reservation-form]",
  );

  // Am Formular statt importiert: ein `import { BUSINESS }` zöge das ganze
  // Konstantenmodul in den Browser-Bundle, für eine Telefonnummer.
  const WHATSAPP_NUMBER = form?.dataset.whatsapp ?? "";
  const status = document.querySelector<HTMLElement>("[data-form-status]");

  const formatDateTime = (value: string) => {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return value;
    return new Intl.DateTimeFormat("de-CH", {
      dateStyle: "full",
      timeStyle: "short",
    }).format(date);
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const fields = Array.from(
      form.querySelectorAll<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >("input, select, textarea"),
    );

    // Aufräumen, bevor neu geprüft wird — sonst bleibt die Markierung eines
    // inzwischen ausgefüllten Feldes stehen.
    fields.forEach((field) => {
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
    });

    if (!form.checkValidity()) {
      // Ohne diese beiden Attribute bekam ein Screenreader nur den einen Satz
      // am Formularende zu hören, ohne Bezug zum betroffenen Feld.
      fields
        .filter((field) => !field.checkValidity())
        .forEach((field) => {
          field.setAttribute("aria-invalid", "true");
          field.setAttribute("aria-describedby", "res-status");
        });

      form.reportValidity();
      if (status) {
        status.replaceChildren(
          "Bitte Name, Telefon, Datum und Personenzahl ausfüllen.",
        );
        status.classList.add("is-error");
      }
      return;
    }

    const data = new FormData(form);
    const message = data.get("message")?.toString().trim();

    const lines = [
      "Tischanfrage Flamingo Bar",
      `Name: ${data.get("name")}`,
      `Telefon: ${data.get("phone")}`,
      `Wann: ${formatDateTime(data.get("datetime")?.toString() ?? "")}`,
      `Personen: ${data.get("people")}`,
    ];
    if (message) lines.push(`Bemerkung: ${message}`);

    const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(lines.join("\n"))}`;
    const chat = window.open(url, "_blank", "noopener");

    if (status) {
      status.classList.remove("is-error");
      if (chat) {
        status.replaceChildren(
          "WhatsApp wird geöffnet. Die Anfrage ist bereits vorbereitet.",
        );
      } else {
        // Safari und jeder Popup-Blocker geben hier `null` zurück. Vorher
        // stand die Erfolgsmeldung schon vor dem Aufruf da: der Gast las
        // "wird geöffnet", und es passierte nichts.
        const link = document.createElement("a");
        link.href = url;
        link.target = "_blank";
        link.rel = "noopener";
        link.textContent = "Anfrage in WhatsApp öffnen";
        status.replaceChildren(
          "Der Browser hat das Fenster blockiert. ",
          link,
          " — oder ruf uns einfach an.",
        );
      }
    }
  });
</script>

<style is:global>
  @layer components {
    /* ------------------------------------------------------------------- form */
    .form {
      display: grid;
      gap: var(--space-4);
      padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: color-mix(in lab, var(--text) 2%, transparent);
    }

    .form_field {
      display: grid;
      gap: 0.45rem;
    }

    .form_label {
      font-family: var(--mono-family);
      font-size: 0.625rem;
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: color-mix(in lab, currentcolor 60%, transparent);
    }

    .form_input {
      width: 100%;
      padding: 0.8rem 0.9rem;
      font-family: var(--primary-family);
      font-size: 1rem;
      color: var(--text);
      background-color: color-mix(in lab, var(--text) 4%, transparent);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      transition:
        border-color var(--duration-fast),
        background-color var(--duration-fast);
    }

    .form_input:focus-visible {
      outline: var(--focus-width) solid var(--brand-500);
      outline-offset: var(--focus-offset);
      border-color: color-mix(in lab, var(--brand-500) 50%, transparent);
    }

    textarea.form_input {
      resize: vertical;
      min-height: 6rem;
    }

    .form_note {
      color: var(--text-faded);
      margin: 0;
    }

    .form_status {
      margin: 0;
      min-height: 1.2em;
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      color: var(--brand-500-soft);
    }

    .form_status.is-error {
      color: var(--brand-500);
    }

    /* ------------------------------------------------------------------ aside */
    .reservation_aside {
      display: grid;
      justify-items: start;
      gap: 0;
    }

    .reservation_visual {
      width: 100%;
      aspect-ratio: 3 / 2;
      margin-bottom: var(--space-5);
      border-radius: var(--radius-main);
      overflow: clip;
    }

    .reservation_visual img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .reservation_hours {
      width: 100%;
      margin-top: var(--space-6);
    }

    .reservation_label {
      color: var(--text-faded);
      margin-bottom: var(--space-2);
    }

    /* ---------------------------------------------------------------- options */
  }
</style>
