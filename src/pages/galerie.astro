---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Section.astro";
import PageHeader from "@/components/PageHeader.astro";
import PageHero from "@/components/PageHero.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Img from "@/components/Img.astro";
import Icon from "@/components/Icon.astro";
import closeIcon from "@/assets/icons/close.svg";
import barGuestsImage from "@/assets/flamingo/bar-guests-night.jpeg";
import neonGlassesImage from "@/assets/flamingo/mood-neon-glasses.jpeg";
import cocktailHandImage from "@/assets/flamingo/mood-cocktail-hand.jpeg";
import djKnobsImage from "@/assets/flamingo/mood-dj-knobs.jpeg";
import djMixerImage from "@/assets/flamingo/event-dj-mixer.jpeg";
import crowdImage from "@/assets/flamingo/event-crowd-dancing.jpeg";
import liveSessionImage from "@/assets/flamingo/event-live-session.jpeg";
import bottleImage from "@/assets/flamingo/bottle-service-lounge.jpeg";
import aperolImage from "@/assets/flamingo/drink-aperol-spritz.jpeg";
import longIslandImage from "@/assets/flamingo/drink-long-island.jpeg";
import pinaColadaImage from "@/assets/flamingo/drink-pina-colada.jpeg";
import Schema from "@/components/Schema.astro";
import { breadcrumbSchema } from "@/utils/schema.ts";
import { BUSINESS } from "@/consts.ts";

/**
 * Die Kacheln der Galerie. Sie laufen als Mosaik in Spalten (CSS
 * `columns`), nicht in einem Zeilenraster — deshalb steuert `ratio` nur das
 * Seitenverhältnis der einzelnen Kachel, nicht ihre Spannweite. Die
 * unterschiedlichen Höhen sind das, was das Mosaik dicht wirken lässt.
 *
 * `caption` steht nicht mehr unter dem Bild, sondern beschriftet nur noch den
 * Button (`aria-label`) und die Grossansicht.
 *
 * Stand als elf ausgeschriebene <figure>-Blöcke im Markup, weil Stackis alter
 * Marker-Parser kein `.map()` verstand. Stacki hat inzwischen eigene
 * Loop-Knoten (siehe AGENTS.md), also ist die Liste wieder eine Liste.
 */
type Tile = {
  image: ImageMetadata;
  alt: string;
  caption: string;
  /** Seitenverhältnis der Kachel. Ohne Angabe: Quadrat. */
  ratio?: "portrait" | "tall" | "landscape";
  /** Nur die Kacheln über der Falz laden sofort. */
  eager?: boolean;
};

const tiles: Tile[] = [
  {
    image: barGuestsImage,
    caption: "Die Bar",
    ratio: "portrait",
    eager: true,
    alt: "Gäste an der Bartheke der Flamingo Bar bei Nacht, Neon-Pink beleuchtet",
  },
  {
    image: neonGlassesImage,
    caption: "Neonlicht",
    ratio: "landscape",
    eager: true,
    alt: "Zwei Drinks auf der Bartheke, Neonschild im Hintergrund",
  },
  {
    image: aperolImage,
    caption: "Aperitif",
    ratio: "tall",
    eager: true,
    alt: "Orangefarbener Aperitif im beschlagenen Glas mit Orangenscheibe und Minze",
  },
  {
    image: cocktailHandImage,
    caption: "An der Bar",
    ratio: "portrait",
    eager: true,
    alt: "Hand hält einen Tumbler mit Eiswürfeln",
  },
  {
    image: djKnobsImage,
    caption: "Am Pult",
    ratio: "tall",
    alt: "Hände am DJ-Mixer, pinker Laserstrahl über der Konsole",
  },
  {
    image: longIslandImage,
    caption: "Longdrink",
    alt: "Longdrinkglas mit Eis und Zitronenscheibe",
  },
  {
    image: crowdImage,
    caption: "Tanzfläche",
    ratio: "landscape",
    alt: "Tanzende Gäste im Konfettiregen an einer Motto-Party",
  },
  {
    image: djMixerImage,
    caption: "DJ-Abend",
    ratio: "portrait",
    alt: "DJane am Pult, pinke Lichtstrahlen über der Menge",
  },
  {
    image: liveSessionImage,
    caption: "Live Session",
    ratio: "tall",
    alt: "Musiker mit Gitarre am Mikrofon im pinken Gegenlicht",
  },
  {
    image: pinaColadaImage,
    caption: "Auf Eis",
    ratio: "portrait",
    alt: "Glas mit Ananasscheibe und Cocktailkirsche an der Bar",
  },
  {
    image: bottleImage,
    caption: "Flaschenservice",
    ratio: "landscape",
    alt: "Gäste in der Loge mit Flasche im Eiskübel und Wunderkerze",
  },
];
---

<Layout
  title="Galerie – Bar, Drinks und Nächte"
  description="Bilder aus der Flamingo Bar Langenthal: die Bartheke bei Nacht, Drinks und Longdrinks, DJ-Abende, Motto-Partys und die Logen mit Flaschenservice."
  theme="dark"
>
  <Schema
    slot="head"
    data={breadcrumbSchema([{ name: "Galerie", path: "/galerie" }])}
  />
  {/* Kein Hero-Bild: das Mosaik beginnt direkt darunter, ein zwölftes Foto
       davor sähe nach Versehen aus. */}
  <PageHero eyebrow="Galerie" heading="Bar, Drinks und lange Nächte" text="So sieht es aus, wenn es voll wird: pinkes Licht, beschlagene Gläser, die Fläche um Mitternacht. Zum Vergrössern antippen." image={crowdImage} glow={false} />

  <Section paddingTop="small" paddingBottom="medium">
    <div class="gallery_grid measure-main">
      {
        tiles.map((tile) => (
          <figure
            class:list={["gallery_tile", tile.ratio && `is-${tile.ratio}`]}
          >
            <button
              class="gallery_button"
              type="button"
              data-caption={tile.caption}
              aria-label={`${tile.caption} vergrössern`}
            >
              <Img
                src={tile.image}
                alt={tile.alt}
                loading={tile.eager ? "eager" : undefined}
              />
            </button>
          </figure>
        ))
      }
    </div>
  </Section>

  <dialog class="lightbox" data-lightbox aria-label="Bild in Grossansicht">
    <button
      class="lightbox_close"
      type="button"
      data-lightbox-close
      aria-label="Schliessen"
    >
      <Icon src={closeIcon} variant="small" />
    </button>
    <img
      class="lightbox_image"
      data-lightbox-image
      alt=""
      width="1376"
      height="768"
      decoding="async"
    />
    <p class="lightbox_caption text-style-small" data-lightbox-caption></p>
  </dialog>

  <Section paddingTop="medium" paddingBottom="large" align="center">
    <PageHeader
      headingTag="h2"
      variant="h3"
      maxWidth="none"
      heading="Aktuelleres steht auf Instagram"
      text="Kurzfristige Ankündigungen und Bilder vom letzten Wochenende laufen dort."
    >
      <ButtonWrapper>
        <Button element="link" href={BUSINESS.instagram}
          >{BUSINESS.instagramHandle}</Button
        >
        <Button element="link" href="/getraenkekarte/" variant="secondary">
          Getränkekarte ansehen
        </Button>
      </ButtonWrapper>
    </PageHeader>
  </Section>
</Layout>

<script>
  // Lightbox: nimmt die schon geladene Variante des Bildes (`currentSrc`),
  // damit kein zweiter Download nötig ist. Ohne JS bleiben die Kacheln
  // sichtbar, sie lassen sich nur nicht vergrössern.
  const dialog = document.querySelector<HTMLDialogElement>("[data-lightbox]");
  const target = document.querySelector<HTMLImageElement>(
    "[data-lightbox-image]",
  );
  const caption = document.querySelector<HTMLElement>(
    "[data-lightbox-caption]",
  );
  const close = document.querySelector<HTMLButtonElement>(
    "[data-lightbox-close]",
  );

  document
    .querySelectorAll<HTMLButtonElement>(".gallery_button")
    .forEach((button) => {
      button.addEventListener("click", () => {
        const image = button.querySelector("img");
        if (!dialog || !target || !image) return;

        target.src = image.currentSrc || image.src;
        target.alt = image.alt;
        // Die Beschriftung steht nur noch am Button — unter den Kacheln
        // erscheint sie nicht mehr, in der Grossansicht schon.
        const label = button.dataset.caption ?? "";
        if (caption) caption.textContent = label;
        // Der Dialog hieß fest "Bild in Grossansicht" — er sagte also nie,
        // welches Bild gerade offen ist.
        dialog.setAttribute(
          "aria-label",
          label ? `${label} — Grossansicht` : "Bild in Grossansicht",
        );
        dialog.showModal();
      });
    });

  close?.addEventListener("click", () => dialog?.close());

  // Klick auf den Hintergrund schliesst ebenfalls — das Bild selbst nicht.
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style is:global>
  @layer components {
    /* Mosaik in Spalten statt Zeilenraster: die Kacheln behalten ihr eigenes
       Seitenverhältnis und stapeln sich lückenlos, statt sich an eine
       gemeinsame Zeilenhöhe zu binden. `columns` reicht dafür — ein Grid
       bräuchte `masonry`, das noch nicht überall ausgeliefert wird.
       Reihenfolge ist dadurch spaltenweise; für eine Bildergalerie ohne
       inhaltliche Abfolge ist das kein Verlust. */
    .gallery_grid {
      --_gallery-gap: 0.5rem;

      columns: 2;
      column-gap: var(--_gallery-gap);
    }

    @media (min-width: 48rem) {
      .gallery_grid {
        columns: 4;
      }
    }

    @media (min-width: 64rem) {
      .gallery_grid {
        columns: 5;
      }
    }

    .gallery_tile {
      margin: 0 0 var(--_gallery-gap);
      /* Sonst zerschneidet der Spaltenumbruch eine Kachel mitten im Bild. */
      break-inside: avoid;
      min-width: 0;
    }

    .gallery_button {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      /* Kleiner als --radius-main: bei fünf Spalten frisst der Karten-Radius
         die Ecke des Bildes sichtbar an. */
      border-radius: 0.5rem;
      background-color: transparent;
      cursor: pointer;
      overflow: clip;
      /* Ohne isolation überlagert der Zoom im Hover die Nachbarkachel. */
      isolation: isolate;
    }

    .gallery_button img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      transition: transform var(--duration-medium) var(--ease-out);
    }

    .gallery_tile.is-portrait .gallery_button img {
      aspect-ratio: 4 / 5;
    }

    .gallery_tile.is-tall .gallery_button img {
      aspect-ratio: 3 / 4;
    }

    .gallery_tile.is-landscape .gallery_button img {
      aspect-ratio: 4 / 3;
    }

    @media (hover: hover) {
      .gallery_button:hover img {
        transform: scale(1.04);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .gallery_button img {
        transition: none;
      }
    }

    /* -------------------------------------------------------------- lightbox */
    .lightbox {
      /* Ein modaler Dialog wird vom Browser mit `margin: auto` zentriert. Der
         globale Reset setzt jede Margin auf 0 und nimmt ihm genau das weg — die
         Grossansicht klebte in der linken oberen Ecke, und der Schliessen-Knopf
         (`top: -0.5rem`) lag dadurch ausserhalb des Bildschirms. */
      margin: auto;
      width: min(92vw, 60rem);
      max-width: none;
      max-height: 92svh;
      padding: 0;
      border: 0;
      border-radius: var(--radius-main);
      background-color: transparent;
      color: var(--light-100);
      overflow: visible;
      /* Die Grossansicht stand vorher schlagartig im Bild — Foto und
         Verdunkelung erschienen zwischen zwei Bildern aus dem Nichts. Sie
         wächst deshalb aus 96 % heran statt aus dem Punkt: nichts in der Welt
         taucht aus dem Nichts auf. `allow-discrete` überträgt die Bewegung auf
         `display` und `overlay`, sonst wäre der Dialog beim Schliessen weg,
         bevor sich etwas bewegt hat. Browser ohne die Regel zeigen ihn wie
         bisher sofort. */
      opacity: 0;
      transform: scale(0.96);
      transition:
        opacity var(--duration-fast) var(--ease-out),
        transform var(--duration-fast) var(--ease-out),
        overlay var(--duration-fast) allow-discrete,
        display var(--duration-fast) allow-discrete;

      &[open] {
        opacity: 1;
        transform: scale(1);

        @starting-style {
          opacity: 0;
          transform: scale(0.96);
        }
      }
    }

    .lightbox::backdrop {
      background-color: color-mix(in srgb, var(--dark-900) 88%, transparent);
      backdrop-filter: blur(0.375rem);
      opacity: 0;
      transition:
        opacity var(--duration-fast) var(--ease-out),
        overlay var(--duration-fast) allow-discrete,
        display var(--duration-fast) allow-discrete;
    }

    .lightbox[open]::backdrop {
      opacity: 1;
    }

    @starting-style {
      .lightbox[open]::backdrop {
        opacity: 0;
      }
    }

    /* Fällt die Unschärfe ganz aus, trennt nur noch die Deckkraft das
       geöffnete Bild von der Seite darunter. 88 % lassen die Mosaik-Kacheln
       durchscheinen, was hinter einem freigestellten Foto unruhig wirkt. */
    @supports not (
      (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
    ) {
      .lightbox::backdrop {
        background-color: color-mix(in srgb, var(--dark-900) 96%, transparent);
      }
    }

    .lightbox_image {
      width: 100%;
      max-height: 82svh;
      object-fit: contain;
      border-radius: var(--radius-main);
    }

    .lightbox_caption {
      margin: var(--space-3) 0 0;
      text-align: center;
      color: color-mix(in lab, var(--light-100) 55%, transparent);
    }

    .lightbox_close {
      position: absolute;
      top: -0.5rem;
      right: -0.5rem;
      z-index: 1;
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      padding: 0;
      border: var(--border-width) solid
        color-mix(in srgb, var(--light-100) 24%, transparent);
      border-radius: var(--radius-round);
      background-color: color-mix(in srgb, var(--dark-900) 70%, transparent);
      color: var(--light-100);
      cursor: pointer;
      transition:
        background-color var(--duration-fast),
        border-color var(--duration-fast);
    }

    @media (hover: hover) {
      .lightbox_close:hover {
        background-color: var(--brand-500);
        border-color: var(--brand-500);
        color: var(--brand-text);
      }
    }
  }
</style>
