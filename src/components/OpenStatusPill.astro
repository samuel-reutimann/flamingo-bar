---
/**
 * „Jetzt geöffnet · Heute 20 – 04 Uhr“.
 *
 * Stand zweimal da — als Eyebrow im Hero und als eigenständige Pille auf
 * `/oeffnungszeiten` — mit doppeltem Markup, doppeltem CSS und zweimal
 * derselben `renderStatus()`-Funktion samt eigenem `setInterval`.
 *
 * Den Text setzt das Skript in `BaseLayout.astro`: es sucht jede
 * `[data-open-status]` auf der Seite. Absichtlich dort und nicht hier — ein
 * gebündeltes Komponenten-Skript verliert Astro, sobald die Komponente in
 * einem `<Section>`-Slot steckt, und genau dort steht diese Pille.
 *
 * Ohne JS bleibt sie unsichtbar: lieber gar keine Angabe als eine, die auf
 * dem Stand des letzten Builds stehengeblieben ist. Unsichtbar heisst hier
 * `visibility: hidden` und nicht `display: none` — die Pille belegt ihren
 * Platz von Anfang an. Mit `hidden` rutschte die H1 im Hero beim ersten
 * Skriptlauf nach unten: 7 px auf dem Desktop, 26 px auf dem Handy, auf
 * jedem Aufruf.
 *
 * Damit der reservierte Platz stimmt, steht schon im HTML die *längste*
 * Beschriftung, die das Skript setzen kann („Jetzt geschlossen“ plus die
 * breiteste Zeitangabe der Woche). Sichtbar wird sie nie — das Skript
 * überschreibt sie, bevor es die Pille freigibt.
 */
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/Eyebrow.astro";
import { getHours } from "@/utils/content.ts";
import { todayHoursLabel, dayTimesFrom, openTimesFrom } from "@/utils/hours.ts";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * `eyebrow` ist die Zeile über der H1 im Hero — sie erbt die Eyebrow-Optik.
   * `pill` ist die freistehende, umrandete Pille auf `/oeffnungszeiten`.
   */
  variant?: "eyebrow" | "pill";
}

const {
  render = true,
  variant = "pill",
  class: className,
  ...rest
} = Astro.props;

/* Der Platzhalter ist nicht getippt, sondern gerechnet: die breiteste
   Zeitangabe, die `todayHoursLabel()` über die Woche ausgeben kann. Ändert
   die Bar ihre Zeiten in Keystatic, wächst der reservierte Platz mit. */
const hours = await getHours();
const dayTimes = dayTimesFrom(hours);
const openTimes = openTimesFrom(hours);
const widestHours = [0, 1, 2, 3, 4, 5, 6]
  .map((day) => todayHoursLabel(day, dayTimes, openTimes))
  .reduce(
    (longest, label) => (label.length > longest.length ? label : longest),
    "",
  );

/* „Jetzt geschlossen“ ist länger als „Jetzt geöffnet“ — beide setzt das
   Skript in `BaseLayout.astro`. */
const widestStatus = "Jetzt geschlossen";
---

{
  render &&
    (variant === "eyebrow" ? (
      <Eyebrow
        class:list={["status_pill", "is-eyebrow", "is-pending", className]}
        data-open-status
        {...rest}
      >
        <span class="status_dot" aria-hidden="true" />
        <span class="status_text">{widestStatus}</span>
        <span class="status_sep" aria-hidden="true" />
        <span class="status_hours" data-open-hours>
          {widestHours}
        </span>
      </Eyebrow>
    ) : (
      <div
        class:list={["status_pill", "is-pending", className]}
        data-open-status
        {...rest}
      >
        <span class="status_dot" aria-hidden="true" />
        <span class="status_text">{widestStatus}</span>
        <span class="status_sep" aria-hidden="true" />
        <span class="status_hours" data-open-hours>
          {widestHours}
        </span>
      </div>
    ))
}

<style is:global>
  @layer components {
    .status_pill:not(.is-eyebrow) {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      margin-inline: auto;
      padding: 0.55rem 1rem;
      border-radius: var(--radius-round);
      border: var(--border-width) solid
        color-mix(in srgb, var(--brand-500) 28%, transparent);
      background-color: color-mix(in srgb, var(--brand-500) 7%, transparent);
      font-family: var(--mono-family);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .status_pill:not(.is-eyebrow).is-closed {
      border-color: var(--border);
      background-color: color-mix(in lab, var(--text) 3%, transparent);
    }

    /* Im Hero liefert Eyebrow die Typografie; nur die Innenausrichtung fehlt. */
    .status_pill.is-eyebrow {
      margin-bottom: var(--space-4);
    }

    .status_pill.is-eyebrow .eyebrow_text {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
    }

    /* Solange das Skript nicht gelaufen ist, steht die Pille unsichtbar an
       ihrem Platz. `visibility` statt `display: none`, damit nichts nachrückt,
       wenn sie erscheint. Anders als `display: none` nimmt `visibility`
       die Box nicht aus dem Fluss, und der Platzhaltertext darin bleibt
       Screenreadern verborgen. */
    .status_pill.is-pending {
      visibility: hidden;
    }

    .status_dot {
      flex: none;
      width: 0.35rem;
      height: 0.35rem;
      border-radius: var(--radius-round);
      background-color: var(--brand-500);
      box-shadow: var(--shadow-accent-glow);
    }

    /* Nur der Hero pulsiert — auf `/oeffnungszeiten` steht die Pille still,
       dort ist sie die Hauptaussage und kein Blickfang. */
    .status_pill.is-eyebrow .status_dot {
      animation: dot-pulse 2.4s ease-in-out infinite;
    }

    .status_pill.is-closed .status_dot {
      background-color: color-mix(in lab, currentcolor 40%, transparent);
      box-shadow: none;
      animation: none;
    }

    /* Die Uhrzeit steht eine Stufe leiser als „Jetzt geöffnet“ — nur im
       Hero, wo sie neben der Aussage steht statt sie zu sein. */
    .status_pill.is-eyebrow .status_hours {
      color: var(--text-subtle);
    }

    .status_sep {
      width: 1px;
      height: 0.7rem;
      background-color: color-mix(in lab, currentcolor 18%, transparent);
    }

    @keyframes dot-pulse {
      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }
      50% {
        transform: scale(1.5);
        opacity: 0.55;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .status_pill .status_dot {
        animation: none;
      }
    }
  }
</style>
