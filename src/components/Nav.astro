---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { overlap = false } = Astro.props;

/** Marks the link for the page being viewed. Trailing slashes are ignored. */
const isCurrent = (href: string) =>
  Astro.url.pathname.replace(/\/+$/, "") === href.replace(/\/+$/, "")
    ? "page"
    : undefined;
---

<div class:list={["nav_wrap", overlap && "overlap"]} data-nav>
  <div class="nav_pill">
    <div class="nav_bar">
      <a class="nav_logo" href="/" aria-label={SITE_NAME}>Flamingo</a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_line"></span>
        <span class="nav_toggle_line"></span>
      </button>
    </div>
    <nav class="nav_menu" id="nav-menu" aria-label="Hauptnavigation">
      <div class="nav_menu_list">
        <a class="nav_link" href="/" aria-current={isCurrent("/")}>
          Startseite
        </a>
        <a
          class="nav_link"
          href="/getraenkekarte/"
          aria-current={isCurrent("/getraenkekarte")}
        >
          Getränkekarte
        </a>
        <a class="nav_link" href="/events/" aria-current={isCurrent("/events")}>
          Events
        </a>
        <a
          class="nav_link"
          href="/galerie/"
          aria-current={isCurrent("/galerie")}
        >
          Galerie
        </a>
        <a
          class="nav_link"
          href="/oeffnungszeiten/"
          aria-current={isCurrent("/oeffnungszeiten")}
        >
          Öffnungszeiten
        </a>
        <a
          class="nav_link"
          href="/kontakt/"
          aria-current={isCurrent("/kontakt")}
        >
          Kontakt
        </a>
        <a
          class="nav_link"
          href="/reservation/"
          aria-current={isCurrent("/reservation")}
        >
          Tisch anfragen
        </a>
      </div>
    </nav>
  </div>
</div>

{
  /* Without scripting the button can't do anything, so show the links instead. */
}
<noscript>
  <style>
    /* Muss in einen Layer: ungeschichtetes CSS schlägt jede Schicht, auch
       `utilities`. Der Block steht im Body, die Komponenten-Styles im Head —
       innerhalb derselben Schicht gewinnt also weiterhin dieser hier. */
    @layer components {
      .nav_toggle {
        display: none;
      }
      .nav_menu {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-top: 1.5rem;
        visibility: visible;
      }
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const pill = nav?.querySelector<HTMLElement>(".nav_pill");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const menu = nav?.querySelector<HTMLElement>(".nav_menu");

  if (nav && pill && toggle && menu) {
    const setOpen = (open: boolean) => {
      pill.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      // `aria-label` stand fest auf "Menü öffnen" — bei offenem Menü las ein
      // Screenreader also "Menü öffnen, erweitert".
      toggle.setAttribute(
        "aria-label",
        open ? "Menü schliessen" : "Menü öffnen",
      );
      // `inert` nimmt die Links zusätzlich aus dem Accessibility-Tree; die
      // CSS-Sichtbarkeit allein greift erst nach der Übergangszeit.
      menu.inert = !open;
    };

    setOpen(false);

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll(".nav_link").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && pill.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!pill.classList.contains("is-open") || !(target instanceof Node))
        return;
      if (!pill.contains(target)) setOpen(false);
    });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: fixed;
      top: 1.1rem;
      left: 0;
      right: 0;
      z-index: 50;
      display: flex;
      justify-content: center;
      pointer-events: none;
    }

    .nav_pill {
      pointer-events: auto;
      display: grid;
      width: min(34rem, calc(100% - 2.5rem));
      padding: 0.8rem 1.25rem;
      background: var(--gradient-glass);
      backdrop-filter: var(--blur-glass);
      border: var(--border-width) solid var(--border-glass);
      border-radius: 1.15rem;
      box-shadow: var(--shadow-nav);
    }

    /* Ohne `backdrop-filter` gibt es nichts, was das Foto hinter der Pille
       ruhig stellt: `--gradient-glass` ist zu 87 % durchsichtig und die Links
       stünden direkt auf dem Bild. Safari vor 18 kennt nur die Fassung mit
       `-webkit-`, ältere Firefox-Versionen keine von beiden — die Abfrage
       nennt deshalb beide Schreibweisen. */
    @supports not (
      (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
    ) {
      .nav_pill {
        background: var(--gradient-glass-opaque);
      }
    }

    /* `is-preload` steht auf <html>, solange eine Seite ihre Einblend-Animation
       noch nicht gestartet hat. Die Regel gehört hierher und nicht in die
       Seite: die Pille ist Sache dieser Komponente. */
    .is-preload .nav_pill {
      opacity: 0;
    }

    .nav_bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
    }

    .nav_logo {
      font-family: var(--display-family);
      font-size: 1.3rem;
      color: var(--light-100);
      text-decoration: none;
      transition: color var(--duration-fast);
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500-soft);
        }
      }
    }

    /* Die Klappbewegung läuft über die Zeilenhöhe des Rasters, nicht über
       `max-height`. Der alte Deckel stand auf 32rem, die sieben Links sind
       aber nur rund 20rem hoch: Vier Zehntel der Zeit liefen ins Leere, was
       sich beim Schliessen als Gedenksekunde anfühlte, bevor sich überhaupt
       etwas bewegte. `0fr → 1fr` misst der Browser selbst, die Bewegung endet
       also genau dann, wenn das Menü zu ist. */
    .nav_menu {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      /* Ohne `visibility` blieben die Links im Tab-Fokus und im
         Accessibility-Tree, obwohl das Menü zu ist — auf jeder Seite. Die
         Verzögerung lässt die Klappbewegung zu Ende laufen, bevor sie
         verschwinden. */
      visibility: hidden;
      transition:
        grid-template-rows var(--duration-slow) var(--ease-out),
        opacity var(--duration-fast) var(--ease-out),
        margin-top var(--duration-slow) var(--ease-out),
        visibility 0s linear var(--duration-slow);
    }

    /* `min-height: 0` hebt die Mindesthöhe auf, die ein Rasterelement sonst
       von seinem Inhalt erbt — ohne sie faltet sich nichts zusammen. */
    .nav_menu_list {
      display: grid;
      gap: 0.35rem;
      min-height: 0;
      overflow: hidden;
    }

    .nav_pill.is-open .nav_menu {
      grid-template-rows: 1fr;
      opacity: 1;
      margin-top: 1.5rem;
      visibility: visible;
      transition-delay: 0s;
    }

    .nav_link {
      font-family: var(--display-family);
      font-size: clamp(1.6rem, 3vw, 2.25rem);
      line-height: 1.25;
      color: var(--light-100);
      text-decoration: none;
      transition: color var(--duration-fast);
      &[aria-current="page"] {
        color: var(--brand-500-soft);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500-soft);
        }
      }
    }

    .nav_toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-end;
      gap: 0.375rem;
      width: 1.75rem;
      height: 1.75rem;
      border: 0;
      padding: 0;
    }

    .nav_toggle_line {
      display: block;
      width: 1.4rem;
      height: 0.09375rem;
      background-color: var(--light-100);
      transition:
        transform var(--duration-fast) var(--ease-out),
        opacity var(--duration-fast) var(--ease-out);
    }

    .nav_pill.is-open .nav_toggle_line:first-child {
      transform: translateY(0.234375rem) rotate(45deg);
    }
    .nav_pill.is-open .nav_toggle_line:last-child {
      transform: translateY(-0.234375rem) rotate(-45deg);
    }

    @media (width < 62rem) {
      .nav_pill {
        width: calc(100% - 2rem);
        padding: 0.9rem 1.25rem;
      }
      .nav_logo {
        font-size: 1.2rem;
      }
    }
  }
</style>
