---
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
}

const { overlap = false } = Astro.props;

/** Marks the link for the page being viewed. Trailing slashes are ignored. */
const isCurrent = (href: string) =>
  Astro.url.pathname.replace(/\/+$/, "") === href.replace(/\/+$/, "")
    ? "page"
    : undefined;
---

<div class:list={["nav_wrap", overlap && "overlap"]} data-nav>
  <div class="nav_pill">
    <div class="nav_bar">
      <a class="nav_logo" href="/" aria-label={SITE_NAME}>Flamingo</a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_line"></span>
        <span class="nav_toggle_line"></span>
      </button>
    </div>
    <nav class="nav_menu" id="nav-menu" aria-label="Hauptnavigation">
      <a class="nav_link" href="/" aria-current={isCurrent("/")}>
        Startseite
      </a>
      <a
        class="nav_link"
        href="/getraenkekarte"
        aria-current={isCurrent("/getraenkekarte")}
      >
        Getränkekarte
      </a>
      <a class="nav_link" href="/events" aria-current={isCurrent("/events")}>
        Events
      </a>
      <a class="nav_link" href="/galerie" aria-current={isCurrent("/galerie")}>
        Galerie
      </a>
      <a
        class="nav_link"
        href="/reservation"
        aria-current={isCurrent("/reservation")}
      >
        Tisch anfragen
      </a>
    </nav>
  </div>
</div>

{
  /* Without scripting the button can't do anything, so show the links instead. */
}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      max-height: none;
      opacity: 1;
      margin-top: 1.5rem;
      visibility: visible;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const pill = nav?.querySelector<HTMLElement>(".nav_pill");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const menu = nav?.querySelector<HTMLElement>(".nav_menu");

  if (nav && pill && toggle && menu) {
    const setOpen = (open: boolean) => {
      pill.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      // `aria-label` stand fest auf "Menü öffnen" — bei offenem Menü las ein
      // Screenreader also "Menü öffnen, erweitert".
      toggle.setAttribute("aria-label", open ? "Menü schliessen" : "Menü öffnen");
      // `inert` nimmt die Links zusätzlich aus dem Accessibility-Tree; die
      // CSS-Sichtbarkeit allein greift erst nach der Übergangszeit.
      menu.inert = !open;
    };

    setOpen(false);

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll(".nav_link").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && pill.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!pill.classList.contains("is-open") || !(target instanceof Node))
        return;
      if (!pill.contains(target)) setOpen(false);
    });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: fixed;
      top: 1.1rem;
      left: 0;
      right: 0;
      z-index: 50;
      display: flex;
      justify-content: center;
      pointer-events: none;
    }

    .nav_pill {
      pointer-events: auto;
      display: grid;
      width: min(34rem, calc(100% - 2.5rem));
      padding: 0.8rem 1.25rem;
      background: var(--gradient-glass);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: var(--border-width) solid rgba(255, 255, 255, 0.14);
      border-radius: 1.15rem;
      box-shadow: var(--shadow-nav);
      transition: padding 0.35s ease;
    }

    .nav_bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
    }

    .nav_logo {
      font-family: var(--display-family);
      font-size: 1.3rem;
      color: var(--light-100);
      text-decoration: none;
      transition: color 200ms;
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500-soft);
        }
      }
    }

    .nav_menu {
      display: grid;
      gap: 0.35rem;
      overflow: hidden;
      max-height: 0;
      opacity: 0;
      /* Ohne `visibility` blieben die fünf Links im Tab-Fokus und im
         Accessibility-Tree, obwohl das Menü zu ist — auf jeder Seite. Die
         Verzögerung lässt die Klappbewegung zu Ende laufen, bevor sie
         verschwinden. */
      visibility: hidden;
      transition:
        max-height 0.4s ease,
        opacity 0.3s ease,
        margin-top 0.4s ease,
        visibility 0s linear 0.4s;
    }

    .nav_pill.is-open .nav_menu {
      max-height: 22rem;
      opacity: 1;
      margin-top: 1.5rem;
      visibility: visible;
      transition-delay: 0s;
    }

    .nav_link {
      font-family: var(--display-family);
      font-size: clamp(1.6rem, 3vw, 2.25rem);
      line-height: 1.25;
      color: var(--light-100);
      text-decoration: none;
      transition: color 200ms;
      &[aria-current="page"] {
        color: var(--brand-500-soft);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500-soft);
        }
      }
    }

    .nav_toggle {
      display: inline-flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-end;
      gap: 6px;
      width: 1.75rem;
      height: 1.75rem;
      border: 0;
      padding: 0;
    }

    .nav_toggle_line {
      display: block;
      width: 1.4rem;
      height: 1.5px;
      background-color: var(--light-100);
      transition:
        transform 0.3s ease,
        opacity 0.3s ease;
    }

    .nav_pill.is-open .nav_toggle_line:first-child {
      transform: translateY(3.75px) rotate(45deg);
    }
    .nav_pill.is-open .nav_toggle_line:last-child {
      transform: translateY(-3.75px) rotate(-45deg);
    }

    @media screen and (max-width: 991px) {
      .nav_pill {
        width: calc(100% - 2rem);
        padding: 0.9rem 1.25rem;
      }
      .nav_logo {
        font-size: 1.2rem;
      }
    }
  }
</style>
