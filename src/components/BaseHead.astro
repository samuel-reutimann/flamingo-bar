---
/* Die drei Schnitte, die über dem Falz stehen: H1 (Instrument Serif),
   Fliesstext (Manrope) und die Mono-Labels der Status-Pille. Ohne Preload
   findet der Browser sie erst, wenn er das gebündelte CSS geparst hat — die
   Ersatzschrift steht dann zwei Wasserfall-Stufen lang. Die Metrik-Angleichung
   in `base.css` fängt den Sprung ab, der Preload verkürzt die Zeit, in der er
   überhaupt sichtbar ist.

   Nur die Latin-Datei je Schnitt: die anderen Subsets holt der Browser über
   `unicode-range` ohnehin nie. `?url` liefert den gehashten Build-Pfad. */
import instrumentSerifLatin from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import spaceMonoLatin from "@fontsource/space-mono/files/space-mono-latin-400-normal.woff2?url";
import { SITE_NAME, SITE_DESCRIPTION, SITE_LOCALE } from "@/consts.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const {
  title,
  description = SITE_DESCRIPTION,
  image = "/og-image.jpg",
  type = "website",
  imageAlt = `Flamingo Bar Langenthal – ${title ?? SITE_NAME}`,
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link
  rel="preload"
  href={instrumentSerifLatin}
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href={manropeLatin}
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href={spaceMonoLatin}
  as="font"
  type="font/woff2"
  crossorigin
/>
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={SITE_LOCALE.replace("-", "_")} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#08070a" />
<meta name="generator" content={Astro.generator} />
