---
import { slotContent } from "@/utils/slots.ts";

import type { HTMLAttributes } from "astro/types";

type ButtonProps = HTMLAttributes<"button"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  variant?: "primary" | "secondary" | "link";
  element?: "button";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  href?: never;
};

type LinkProps = Omit<HTMLAttributes<"a">, "type"> & {
  render?: boolean;
  variant?: "primary" | "secondary" | "link";
  element: "link";
  href?: string;
  type?: never;
  disabled?: never;
};

type Props = ButtonProps | LinkProps;

const {
  render = true,
  variant = "primary",
  element = "button",
  href,
  type = "button",
  ...rest
} = Astro.props;
const isLink = element === "link";
const Tag = isLink ? "a" : "button";
const tagAttrs = isLink
  ? { href: href || "#" }
  : { type: type === "submit" ? undefined : type };

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <Tag
      class:list={["button_wrap", variant !== "primary" && variant]}
      {...tagAttrs}
      {...rest}
    >
      <span class="button_text text-style-trim">
        <slot />
      </span>
    </Tag>
  )
}
<script>
  // Hover-Roll: jeder Buchstabe schiebt nach unten weg, die Kopie kommt von
  // oben nach – gestaffelt von links nach rechts. Gilt für Primary und
  // Secondary; der `.link`-Variant bleibt bewusst ohne Roll.
  import { gsap } from "gsap";

  function setupRoll() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document
      .querySelectorAll<HTMLElement>(".button_wrap:not(.link) .button_text")
      .forEach((label) => {
        if (label.dataset.rollReady) return;

        const text = (label.textContent ?? "").trim();
        if (!text) return;

        const button = label.closest<HTMLElement>("a, button") ?? label;
        label.dataset.rollReady = "1";
        label.textContent = "";
        label.style.display = "inline-flex";
        // Ohne `pre` kollabieren die Wortabstände der einzelnen Spalten.
        label.style.whiteSpace = "pre";
        // Zerlegt liest sich der Text sonst als Buchstabensalat vor.
        button.setAttribute("aria-label", text);

        const tops: HTMLElement[] = [];
        const bottoms: HTMLElement[] = [];

        for (const char of text) {
          const column = document.createElement("span");
          column.style.cssText =
            "position:relative;display:inline-block;overflow:hidden;line-height:1.5;vertical-align:top";

          const top = document.createElement("span");
          top.style.cssText = "display:inline-block;will-change:transform";
          top.textContent = char === " " ? "\u00a0" : char;

          // Die Kopie wartet über der Spalte und rückt beim Hover nach.
          const bottom = top.cloneNode(true) as HTMLElement;
          bottom.style.cssText =
            "display:inline-block;position:absolute;left:0;top:-100%;will-change:transform";

          column.append(top, bottom);
          label.appendChild(column);
          tops.push(top);
          bottoms.push(bottom);
        }

        // Beide Ebenen laufen synchron, damit die Kopie nachrückt, während
        // der Buchstabe geht. `overwrite` verhindert, dass schnelles
        // Rein-Raus die Tweens stapelt.
        const roll = (to: number) => {
          const config = {
            yPercent: to,
            duration: 0.42,
            ease: "power3.out",
            stagger: { each: 0.018, from: "start" as const },
            overwrite: true as const,
          };
          gsap.to(tops, config);
          gsap.to(bottoms, config);
        };

        button.addEventListener("mouseenter", () => roll(100));
        button.addEventListener("mouseleave", () => roll(0));
        button.addEventListener("focus", () => roll(100));
        button.addEventListener("blur", () => roll(0));
      });
  }

  setupRoll();
  // Nach einer View-Transition erneut laufen lassen; `rollReady` hält das
  // idempotent.
  document.addEventListener("astro:page-load", setupRoll);
</script>

<style is:global>
  @layer components {
    .button_wrap {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 0.5em;
      padding: 1.25em 1.5em;
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--radius-round);
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      transition:
        background-color 200ms,
        color 200ms,
        border-color 200ms,
        box-shadow 200ms,
        transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
      @media (hover: hover) and (pointer: fine) {
        &:hover {
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
        &:not(.secondary):not(.link):hover {
          box-shadow: var(--shadow-accent-glow);
        }
        &:not(.link):hover {
          transform: translateY(-2px);
        }
      }
      /* Presse-Feedback: der Button gibt sofort nach, damit die Oberfläche
         auf den Klick zu reagieren scheint. Steht nach dem Hover-Block, damit
         der Druck den Lift überschreibt. Der Text-Link skaliert nicht – bei
         blossem Text wirkt das wie ein Wackler. */
      &:not(.link):active {
        transform: scale(0.97);
      }
      &.link:active {
        opacity: 0.7;
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      &.link {
        --button-background: transparent;
        --button-text: var(--brand-500);
        --button-border: transparent;
        --button-background-hover: transparent;
        --button-text-hover: var(--brand-500-soft);
        --button-border-hover: transparent;

        padding: 0;
        border: 0;
        border-radius: 0;
        font-family: var(--mono-family);
        font-size: 0.6875rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
