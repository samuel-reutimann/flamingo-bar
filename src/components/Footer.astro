---
import HoursTable from "@/components/HoursTable.astro";
import { BUSINESS, SITE_NAME } from "@/consts.ts";
---

<footer class="footer_wrap">
  <div class="footer_inner measure-main">
    <div class="footer_top">
      <div class="footer_brand">
        <div class="footer_brand-label text-style-small">{SITE_NAME}</div>
        <p class="footer_brand-address text-style-small">
          {`${BUSINESS.street}, ${BUSINESS.postalCode} ${BUSINESS.city}`}<br />{
            BUSINESS.phoneDisplay
          }
        </p>
      </div>
      <div>
        <div class="footer_brand-label text-style-small">Öffnungszeiten</div>
        <HoursTable variant="compact" />
      </div>
      <nav aria-label="Footer">
        <div class="footer_brand-label text-style-small">Seiten</div>
        <ul class="footer_links">
          <li>
            <a class="footer_link" href="/getraenkekarte/">Getränkekarte</a>
          </li>
          <li><a class="footer_link" href="/events/">Events</a></li>
          <li><a class="footer_link" href="/galerie/">Galerie</a></li>
          <li>
            <a class="footer_link" href="/reservation/">Tisch anfragen</a>
          </li>
          <li>
            <a class="footer_link" href="/oeffnungszeiten/">Öffnungszeiten</a>
          </li>
          <li><a class="footer_link" href="/kontakt/">Kontakt</a></li>
          <li>
            <a class="footer_link" href={BUSINESS.instagram}>Instagram</a>
          </li>
          <li>
            <a class="footer_link" href={BUSINESS.facebook}>Facebook</a>
          </li>
          <li><a class="footer_link" href={BUSINESS.tiktok}>TikTok</a></li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer_wordmark-wrap">
    <div class="footer_wordmark-glow"></div>
    <div class="footer_wordmark">Flamingo</div>
  </div>

  <div class="footer_inner measure-main">
    <div class="footer_bottom">
      <p class="footer_copyright text-style-small">
        &copy; {new Date().getFullYear()}&#160;{SITE_NAME}, Langenthal
      </p>
      <ul class="footer_legal">
        <li><a class="footer_link" href="/impressum/">Impressum</a></li>
        <li><a class="footer_link" href="/datenschutz/">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      flex-direction: column;
      background-color: var(--dark-900);
      color: var(--light-100);
      overflow: hidden;
      position: relative;
      isolation: isolate;
    }

    .footer_inner {
      padding-inline: var(--site-margin);
    }

    .footer_top {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .footer_brand-label {
      font-family: var(--mono-family);
      font-size: 0.5625rem;
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: var(--text-faded);
      margin-bottom: var(--space-2);
    }

    .footer_brand-address {
      color: var(--text-faded);
      line-height: 1.6;
    }

    .footer_links {
      display: grid;
      gap: var(--space-3);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer_link {
      color: var(--text-faded);
      font-size: 0.8125rem;
      text-decoration: none;
      transition: color var(--duration-fast);
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500-soft);
        }
      }
    }

    .footer_wordmark-wrap {
      position: relative;
    }

    .footer_wordmark-glow {
      position: absolute;
      left: 50%;
      bottom: -40%;
      z-index: -1;
      width: min(58rem, 120%);
      aspect-ratio: 1 / 1;
      transform: translateX(-50%);
      background: var(--glow-accent-radial);
      pointer-events: none;
    }

    .footer_wordmark {
      font-family: var(--display-family);
      font-size: clamp(4rem, 22.5vw, 20rem);
      line-height: 0.8;
      letter-spacing: -0.025em;
      text-align: center;
      white-space: nowrap;
      color: var(--light-100);
      /* `line-height: 0.8` macht die Zeilenbox ein Fünftel kürzer als die
         Schrift: die Unterlänge des „g“ ragt unten heraus. Der Ausgleich muss
         deshalb in `em` stehen und mit der Schriftgrösse wachsen — als feste
         0.4rem reichte er nur auf schmalen Telefonen, und ab etwa 768px lag
         das „g“ über der Impressum-Zeile. */
      padding-bottom: 0.22em;
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-faded);
    }

    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
</style>
