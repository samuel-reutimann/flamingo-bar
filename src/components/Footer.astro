---
import { BUSINESS, SITE_NAME } from "@/consts.ts";
---

<footer class="footer_wrap">
  <div class="footer_inner">
    <div class="footer_top">
      <div class="footer_brand">
        <div class="footer_brand-label text-style-small">{SITE_NAME}</div>
        <p class="footer_brand-address text-style-small">
          {BUSINESS.street}, {BUSINESS.postalCode}
          {BUSINESS.city}<br />{BUSINESS.phoneDisplay}
        </p>
      </div>
      <div id="alle-zeiten">
        <div class="footer_brand-label text-style-small">Öffnungszeiten</div>
        <ul class="footer_hours">
          <li class="footer_hours-row is-closed" data-day="1">
            <span>Montag</span><span>Geschlossen</span>
          </li>
          <li class="footer_hours-row is-closed" data-day="2">
            <span>Dienstag</span><span>Geschlossen</span>
          </li>
          <li class="footer_hours-row is-closed" data-day="3">
            <span>Mittwoch</span><span>Geschlossen</span>
          </li>
          <li class="footer_hours-row" data-day="4">
            <span>Donnerstag</span><span>20 – 03 Uhr</span>
          </li>
          <li class="footer_hours-row" data-day="5">
            <span>Freitag</span><span>20 – 04 Uhr</span>
          </li>
          <li class="footer_hours-row" data-day="6">
            <span>Samstag</span><span>20 – 04 Uhr</span>
          </li>
          <li class="footer_hours-row" data-day="0">
            <span>Sonntag</span><span>20 – 01 Uhr</span>
          </li>
        </ul>
      </div>
      <nav aria-label="Footer">
        <div class="footer_brand-label text-style-small">Seiten</div>
        <ul class="footer_links">
          <li>
            <a class="footer_link" href="/getraenkekarte">Getränkekarte</a>
          </li>
          <li><a class="footer_link" href="/events">Events</a></li>
          <li><a class="footer_link" href="/galerie">Galerie</a></li>
          <li><a class="footer_link" href="/reservation">Reservation</a></li>
          <li>
            <a class="footer_link" href="/oeffnungszeiten">Öffnungszeiten</a>
          </li>
          <li><a class="footer_link" href="/kontakt">Kontakt</a></li>
          <li>
            <a class="footer_link" href={BUSINESS.instagram}>Instagram</a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="footer_wordmark-wrap">
    <div class="footer_wordmark-glow"></div>
    <div class="footer_wordmark">Flamingo</div>
  </div>

  <div class="footer_inner">
    <div class="footer_bottom">
      <p class="footer_copyright text-style-small">
        &copy; <span id="year">{new Date().getFullYear()}</span>&#160;{
          SITE_NAME
        }, Langenthal
      </p>
      <ul class="footer_legal">
        <li><a class="footer_link" href="/impressum">Impressum</a></li>
        <li><a class="footer_link" href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }

  // Heutigen Tag in der Öffnungszeiten-Spalte markieren.
  document
    .querySelector(`.footer_hours-row[data-day="${new Date().getDay()}"]`)
    ?.classList.add("is-today");
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      flex-direction: column;
      background-color: var(--dark-900);
      color: var(--light-100);
      overflow: hidden;
      position: relative;
      isolation: isolate;
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      margin-inline: auto;
      padding-inline: var(--site-margin);
    }

    .footer_top {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }

    .footer_brand-label {
      font-family: var(--mono-family);
      font-size: 0.5625rem;
      letter-spacing: var(--letter-spacing-label);
      text-transform: uppercase;
      color: color-mix(in lab, var(--light-100) 48%, transparent);
      margin-bottom: var(--space-2);
    }

    .footer_brand-address {
      color: color-mix(in lab, var(--light-100) 48%, transparent);
      line-height: 1.6;
    }

    .footer_links {
      display: grid;
      gap: var(--space-3);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer_hours {
      display: grid;
      gap: 0.15rem;
      max-width: 22rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer_hours-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding: 0.35rem 0.6rem;
      margin-inline: -0.6rem;
      border-radius: var(--radius-small);
      font-size: 0.8125rem;
      color: color-mix(in lab, var(--light-100) 72%, transparent);
    }

    .footer_hours-row.is-closed {
      color: color-mix(in lab, var(--light-100) 45%, transparent);
    }

    .footer_hours-row.is-today {
      background-color: rgba(255, 46, 136, 0.09);
      box-shadow: inset 0 0 0 1px rgba(255, 46, 136, 0.22);
      color: var(--light-100);
    }

    .footer_hours-row.is-today span:last-child {
      color: var(--brand-500);
    }

    .footer_link {
      color: color-mix(in lab, var(--light-100) 48%, transparent);
      font-size: 0.8125rem;
      text-decoration: none;
      transition: color 200ms;
      @media (hover: hover) {
        &:hover {
          color: var(--brand-500-soft);
        }
      }
    }

    .footer_wordmark-wrap {
      position: relative;
    }

    .footer_wordmark-glow {
      position: absolute;
      left: 50%;
      bottom: -40%;
      z-index: -1;
      width: min(58rem, 120%);
      aspect-ratio: 1 / 1;
      transform: translateX(-50%);
      background: var(--glow-accent-radial);
      pointer-events: none;
    }

    .footer_wordmark {
      font-family: var(--display-family);
      font-size: clamp(4rem, 22.5vw, 20rem);
      line-height: 0.8;
      letter-spacing: -0.025em;
      text-align: center;
      white-space: nowrap;
      color: var(--light-100);
      padding-bottom: 0.4rem;
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: color-mix(in lab, var(--light-100) 48%, transparent);
    }

    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      list-style: none;
      margin: 0;
      padding: 0;
    }
  }
</style>
