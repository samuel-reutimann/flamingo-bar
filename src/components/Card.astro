---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/Eyebrow.astro";
import Heading from "@/components/Heading.astro";
import Paragraph from "@/components/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/ButtonWrapper.astro";
import Img from "@/components/Img.astro";
import Overlay from "@/components/Overlay.astro";

type CardVariant = "default" | "cover" | "stacked";
type CardContentAlign = "start" | "end";
type CardTag = "div" | "listitem" | "article";
type CardTheme = "inherit" | "light" | "dark" | "brand" | "invert";
type HeadingTag = "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
type ImageSource = ImageMetadata | string;

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * Where the image sits.
   *
   * - `default` — no image, text only (default)
   * - `cover` — image fills the card, text over it
   * - `stacked` — image above the text, bleeding to the edges
   */
  variant?: CardVariant;
  /** Small line of text above the heading. */
  eyebrow?: string;
  /** The card's title. */
  heading?: string;
  /** Heading level, for the page outline. Every card heading is the same size. */
  headingTag?: HeadingTag;
  /** Body copy under the heading. */
  text?: string;
  /** Label of the closing button. Nothing renders without one. */
  buttonLabel?: string;
  /** Where the button leads. Left out, it renders as a plain button. */
  buttonHref?: string;
  cardTag?: CardTag;
  /** Colors the card carries with it, whatever section it sits in. */
  theme?: CardTheme;
};

type Props = Base &
  (
    | {
        variant?: "default";
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "cover";
        /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
        image?: ImageSource;
        /** Leave unset on a decorative image — renders `alt=""`. */
        imageAlt?: string;
        /**
         * Lock the card to an aspect ratio (`"3 / 4"`) instead of the fixed
         * 20rem floor — a poster rather than a box. Any CSS `aspect-ratio`.
         *
         * On the stacked variant the same prop shapes the image instead.
         */
        ratio?: string;
        /**
         * Where the text sits in the card. `end` anchors it to the floor,
         * over the gradient. Defaults to `start`.
         */
        contentAlign?: CardContentAlign;
      }
    | {
        variant: "stacked";
        /** A stacked card has no surface of its own, so it keeps the theme around it. */
        theme?: never;
        /** An imported asset, a remote `http(s)` URL, or a path to a file in `public/`. */
        image?: ImageSource;
        /** Leave unset on a decorative image — renders `alt=""`. */
        imageAlt?: string;
        /**
         * The shape of the image (`"1 / 1"`), not of the card. A stacked card
         * is only as tall as its content, so there is no card box to lock —
         * the picture on top is the part with a shape. Defaults to `3 / 2`.
         *
         * The cover variant reads the same prop as the shape of the whole
         * card, because there the image *is* the card.
         */
        ratio?: string;
      }
  );

type AllProps = Base & {
  image?: ImageSource;
  imageAlt?: string;
  ratio?: string;
  contentAlign?: CardContentAlign;
};

const {
  render = true,
  variant = "default",
  eyebrow,
  heading,
  headingTag = "h3",
  text,
  buttonLabel,
  buttonHref,
  cardTag = "div",
  theme = "inherit",
  image,
  imageAlt,
  ratio,
  contentAlign,
  class: className,
  ...rest
} = Astro.props as AllProps;

const Tag = cardTag === "listitem" ? "li" : cardTag;

const hasImage = variant !== "default" && !!image;
const hasContent = !!(eyebrow || heading || text || buttonLabel);
const hasTheme = variant !== "stacked" && theme !== "inherit";

/* The button each variant closes with, so a set of cards reads as one system. */
const buttonVariant =
  variant === "cover"
    ? "primary"
    : variant === "stacked"
      ? "link"
      : "secondary";

if (import.meta.env.DEV && render) {
  if (variant === "stacked" && theme !== "inherit") {
    console.warn(
      '[lumos] <Card variant="stacked"> has no surface to color, so `theme` was dropped. It keeps the theme around it.',
    );
  }
  if (variant === "default" && image) {
    console.warn(
      '[lumos] <Card variant="default"> holds no image, so `image` was dropped. Use the cover or stacked variant to show it.',
    );
  }
  if (variant !== "default" && !image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no \`image\`, so it renders as a plain card.`,
    );
  }
  if (variant === "default" && ratio) {
    console.warn(
      '[lumos] <Card variant="default"> has no box to shape, so `ratio` was dropped. The cover variant shapes the card, the stacked variant shapes its image.',
    );
  }
  if (variant !== "cover" && contentAlign) {
    console.warn(
      `[lumos] <Card variant="${variant}"> ignores \`contentAlign\`; only the cover variant stacks text over the image.`,
    );
  }
}

/* The stylesheet holds the defaults, so only a different value is written out.

   `ratio` means a different thing per variant, because the variants have
   different boxes to shape:

   - `cover` — the image *is* the card, so the ratio shapes the card. It
     replaces the fixed floor rather than fighting it; otherwise the 20rem
     minimum would still win on a narrow card.
   - `stacked` — the card is only as tall as its content, so there is no card
     box worth locking. The ratio shapes the picture sitting on top, which is
     what `--_visual-ratio` already drives.

   A `default` card has no image and no box of its own, so `ratio` has nothing
   to act on there — the dev warning above says so. */
const cardStyle =
  (variant === "cover"
    ? [
        ratio && `--_cover-ratio: ${ratio}`,
        ratio && "--_cover-min-height: 0",
        contentAlign === "end" && "--_content-align: flex-end",
      ]
    : variant === "stacked"
      ? [ratio && `--_visual-ratio: ${ratio}`]
      : []
  )
    .filter(Boolean)
    .join("; ") || undefined;
---

{
  render && (hasContent || hasImage) && (
    <Tag
      class:list={[
        "card_wrap",
        variant !== "default" && variant,
        hasTheme && `theme-${theme}`,
        className,
      ]}
      style={cardStyle}
      {...rest}
    >
      {hasImage && (
        <div class="card_visual">
          <Img src={image!} alt={imageAlt} />
          {/* A cover card's text sits on the image, so the tint is not optional */}
          {variant === "cover" && <Overlay variant="gradient" />}
        </div>
      )}
      {hasContent && (
        <div class="card_content margin-trim">
          <Eyebrow>{eyebrow}</Eyebrow>
          <Heading tag={headingTag} variant="h5">
            {heading}
          </Heading>
          <Paragraph>{text}</Paragraph>
          <ButtonWrapper>
            {buttonHref ? (
              <Button element="link" href={buttonHref} variant={buttonVariant}>
                {buttonLabel}
              </Button>
            ) : (
              <Button variant={buttonVariant}>{buttonLabel}</Button>
            )}
          </ButtonWrapper>
        </div>
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    .card_wrap {
      --_padding: var(--space-6);
      --_min-height: 20rem;
      --_visual-ratio: 3 / 2;
      width: 100%;
      display: flex;
      flex-direction: column;
      /* Separates the visual from the content. Only the stacked variant feels
         it — a cover card's visual is out of flow, a default card has none. */
      gap: var(--_padding);
      position: relative;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      overflow: clip;

      &.cover {
        min-height: var(--_cover-min-height, var(--_min-height));
        aspect-ratio: var(--_cover-ratio, auto);
      }

      /* No surface of its own — the visual is the only thing with edges, and it
         rounds itself, so nothing here needs clipping */
      &.stacked {
        background-color: transparent;
        overflow: visible;
      }

      @media (hover: hover) and (pointer: fine) {
        transition: transform var(--duration-medium) var(--ease-out);

        &:hover {
          transform: translateY(-0.25rem);
        }

        &:hover .card_visual img {
          transform: scale(1.04);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        &:hover {
          transform: none;
        }

        .card_visual img {
          transition: none;
        }

        &:hover .card_visual img {
          transform: none;
        }
      }
    }

    .card_visual {
      position: relative;
      width: 100%;
      flex: none;
      border-radius: inherit;
      overflow: clip;

      /* Das Bild zieht beim Hover heran, die Karte hebt leicht ab. Nur
         transform, damit nichts neu umbricht. Beide laufen über dieselbe
         Dauer: mit 500ms für das Bild und 300ms für die Karte zoomte das Foto
         noch zwei Zehntel weiter, nachdem die Karte längst stand. */
      img {
        transition: transform var(--duration-medium) var(--ease-out);
      }

      .stacked > & {
        aspect-ratio: var(--_visual-ratio);

        /* Das Bild aus dem Fluss nehmen, sonst gibt es kein Seitenverhältnis.

           `aspect-ratio` ist nur eine bevorzugte Grösse: solange das Bild im
           Fluss steht, zählt seine Höhe zur Mindesthöhe der Box, und weil
           `base.css` global `img { height: auto }` setzt, ist das die
           Eigenhöhe des Fotos — die Box wuchs also immer auf das Format des
           Bildes. Deshalb war auch der Standard von 3 / 2 nie zu sehen.

           Dagegen anzuschreiben geht nicht: `base.css` steht in *keinem*
           Layer, und ungelayertes CSS schlägt jede Regel aus
           `@layer components`, unabhängig von der Spezifität.

           `position: absolute` mit `inset: 0` löst das ohne Wettstreit — ein
           ausgerichtetes Element mit `height: auto` füllt seinen Container,
           und aus dem Fluss heraus kann es die Box nicht mehr aufziehen. Das
           globale `object-fit: cover` schneidet den Überstand. Die
           `cover`-Variante macht es zwei Regeln weiter unten genauso. */
        img {
          position: absolute;
          inset: 0;
        }
      }

      .cover > & {
        position: absolute;
        inset: 0;
        height: 100%;
        pointer-events: none;
      }
    }

    .card_content {
      display: flex;
      flex-direction: column;
      justify-content: var(--_content-align, flex-start);
      align-items: var(--_alignment, start);
      text-align: var(--_alignment, start);
      flex-grow: 1;
      width: 100%;
      max-width: 100%;
      padding: var(--_padding);

      /* Fills the card like the default variant does, so the text starts at
         the top and the button still lands on the floor. */
      .cover > & {
        position: relative;
        z-index: 1;
      }

      /* Line the text up with the visual's edges. The wrap's gap opens the space
         under the visual, and the bottom padding stays so a stacked card's
         buttons land level with those on the cards beside it. */
      .stacked > & {
        padding-inline: 0;
        padding-top: 0;
      }
    }
  }
</style>
