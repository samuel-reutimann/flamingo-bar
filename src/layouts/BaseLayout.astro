---
/* Selbst gehostete Schriften: kein Render-Blocking über fonts.googleapis.com,
   keine Drittanbieter-Verbindung. Nur die Subsets und Schnitte, die wirklich
   verwendet werden (latin, kein Italic). */
/* Das Variable-Paket liefert nur eine CSS-Datei für alle Subsets. Über
   `unicode-range` lädt der Browser trotzdem nur die Latin-Datei. */
import "@fontsource-variable/manrope/wght.css";
import "@fontsource/instrument-serif/latin-400.css";
import "@fontsource/space-mono/latin-400.css";
import "@fontsource/space-mono/latin-700.css";
import "@/styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import SkipLink from "@/components/SkipLink.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import { SITE_LOCALE } from "@/consts.ts";
import { getHours } from "@/utils/content.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;

/* Die Öffnungszeiten reisen als JSON mit, weil `src/utils/hours.ts` im
   Browser läuft (Hero-Pill, Strip, Footer) und dort kein `getCollection()`
   möglich ist. Auf jeder Seite, damit jedes Skript sie findet. */
const hours = await getHours();
---

<!doctype html>
<html lang={SITE_LOCALE} class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <script
      type="application/json"
      id="hours-data"
      set:html={JSON.stringify(hours)}
      is:inline
    />
    <SkipLink />
    <Nav overlap={overlap} />
    {
      /* `tabindex` so the jump moves focus here, not just the scroll position */
    }
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Öffnungsstatus für jede `OpenStatusPill` und jede „Heute“-Zeile auf
      // der Seite. Stand vorher zweimal fast gleich in index.astro und
      // oeffnungszeiten.astro, jeweils mit eigenem setInterval. Hier im
      // Layout, weil ein gebündeltes Komponenten-Skript verlorengeht, sobald
      // die Komponente in einem `<Section>`-Slot steckt.
      import {
        isOpenAt,
        todayHoursLabel,
        todayLineLabel,
      } from "@/utils/hours.ts";

      const pills =
        document.querySelectorAll<HTMLElement>("[data-open-status]");
      const todayLines =
        document.querySelectorAll<HTMLElement>("[data-today-line]");

      if (pills.length || todayLines.length) {
        const render = () => {
          const now = new Date();
          const open = isOpenAt(now);
          const hours = todayHoursLabel(now.getDay());

          pills.forEach((pill) => {
            const label = pill.querySelector<HTMLElement>(".status_text");
            const time = pill.querySelector<HTMLElement>("[data-open-hours]");
            pill.classList.toggle("is-closed", !open);
            if (label)
              label.textContent = open ? "Jetzt geöffnet" : "Jetzt geschlossen";
            if (time) time.textContent = hours;
            // Freigeben erst, nachdem die Beschriftung steht: bis dahin hält
            // `is-pending` den Platzhalter unsichtbar, aber im Fluss.
            pill.classList.remove("is-pending");
          });

          const line = todayLineLabel(now.getDay());
          todayLines.forEach((el) => {
            el.textContent = line;
          });
        };

        render();
        // Damit die Pille über Mitternacht hinweg nicht falsch stehenbleibt.
        setInterval(render, 60000);
      }
    </script>
    {
      /* Der Hover-Roll der Buttons steht hier und nicht in `Button.astro`:
        ein gebündeltes Komponenten-Skript lässt Astro fallen, sobald die
        Komponente im Slot einer `<Section>` steht — auf der Startseite und
        auf `/events` kam der Roll deshalb nie an, während er auf allen
        anderen Seiten lief. Dasselbe gilt für `OpenStatusPill`. */
    }
    <script>
      // Hover-Roll: jeder Buchstabe schiebt nach unten weg, die Kopie kommt von
      // oben nach – gestaffelt von links nach rechts. Gilt für Primary und
      // Secondary; der `.link`-Variant bleibt bewusst ohne Roll.
      import { gsap } from "gsap";

      function setupRoll() {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
          return;
        // Ohne echten Zeiger gibt es keinen Hover, der den Roll auslöst — dann
        // muss der Text auch nicht in Buchstabenspalten zerlegt werden. Auf dem
        // Telefon bleibt die Beschriftung damit ein zusammenhängender Text.
        if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches)
          return;

        document
          .querySelectorAll<HTMLElement>(".button_wrap:not(.link) .button_text")
          .forEach((label) => {
            if (label.dataset.rollReady) return;

            const text = (label.textContent ?? "").trim();
            if (!text) return;

            const button = label.closest<HTMLElement>("a, button") ?? label;
            label.dataset.rollReady = "1";
            label.textContent = "";
            label.style.display = "inline-flex";
            // Ohne `pre` kollabieren die Wortabstände der einzelnen Spalten.
            label.style.whiteSpace = "pre";
            // Zerlegt liest sich der Text sonst als Buchstabensalat vor.
            button.setAttribute("aria-label", text);

            const tops: HTMLElement[] = [];
            const bottoms: HTMLElement[] = [];

            for (const char of text) {
              const column = document.createElement("span");
              column.style.cssText =
                "position:relative;display:inline-block;overflow:hidden;line-height:1.5;vertical-align:top";

              const top = document.createElement("span");
              top.style.cssText = "display:inline-block";
              top.textContent = char === " " ? "\u00a0" : char;

              // Die Kopie wartet über der Spalte und rückt beim Hover nach.
              const bottom = top.cloneNode(true) as HTMLElement;
              bottom.style.cssText =
                "display:inline-block;position:absolute;left:0;top:-100%";

              column.append(top, bottom);
              label.appendChild(column);
              tops.push(top);
              bottoms.push(bottom);
            }

            // Die Staffelung ist gedeckelt: bei „Getränkekarte ansehen“ kamen
            // 20 × 0.018s zusammen, der letzte Buchstabe stand also erst nach
            // 0.78s — für eine Hover-Rückmeldung eine halbe Ewigkeit. So bleibt
            // der ganze Lauf unter einer halben Sekunde, egal wie lang die
            // Beschriftung ist.
            const layers = [...tops, ...bottoms];
            const each = Math.min(0.012, 0.18 / Math.max(1, tops.length - 1));

            // Beide Ebenen laufen synchron, damit die Kopie nachrückt, während
            // der Buchstabe geht. `overwrite` verhindert, dass schnelles
            // Rein-Raus die Tweens stapelt.
            const roll = (to: number) => {
              // `will-change` nur für die Dauer der Bewegung: als feste Angabe im
              // Stil hielt es zwei Ebenen pro Buchstabe dauerhaft auf einer
              // eigenen Grafikebene — auf der Startseite gut 400 Stück, die auch
              // dann Speicher belegten, wenn niemand über einen Knopf fuhr.
              const config = {
                yPercent: to,
                duration: 0.32,
                ease: "power3.out",
                stagger: { each, from: "start" as const },
                overwrite: true as const,
              };
              for (const layer of layers) layer.style.willChange = "transform";
              gsap.to(tops, config);
              gsap.to(bottoms, {
                ...config,
                onComplete: () => {
                  for (const layer of layers) layer.style.willChange = "";
                },
              });
            };

            // Kein Roll beim Tastatur-Fokus: Anfang und Ende sehen gleich aus, die
            // Bewegung sagt also nichts — sichtbar wird der Fokus über den
            // Fokusring. Bewegung auf einer Tastenaktion ist reine Verzögerung.
            button.addEventListener("mouseenter", () => roll(100));
            button.addEventListener("mouseleave", () => roll(0));
          });
      }

      setupRoll();
      // Nach einer View-Transition erneut laufen lassen; `rollReady` hält das
      // idempotent.
      document.addEventListener("astro:page-load", setupRoll);
    </script>
    <script is:inline>
      // Heutigen Tag in jeder Öffnungszeiten-Tabelle markieren — der Footer
      // steht auf jeder Seite, Kontakt und Reservation zeigen zusätzlich eine
      // eigene. Ein Skript im Layout trifft alle; in `HoursTable.astro` selbst
      // käme es pro Instanz noch einmal mit. Ohne JS bleibt die Tabelle
      // vollständig lesbar, nur ohne Hervorhebung.
      document
        .querySelectorAll('.hours_row[data-day="' + new Date().getDay() + '"]')
        .forEach(function (row) {
          row.classList.add("is-today");
        });
    </script>
  </body>
</html>
