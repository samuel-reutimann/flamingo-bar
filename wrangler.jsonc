{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flamingo-bar",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],

  // Seit Keystatic ist das kein reiner Asset-Worker mehr: die Redaktion unter
  // `/keystatic` und ihre API-Routen laufen serverseitig. Alle Inhaltsseiten
  // bleiben vorgerendert und kommen weiterhin als Datei aus `assets`.
  //
  // `main` steht bewusst nicht hier — `@astrojs/cloudflare` liest diese Datei
  // beim Build, ergänzt Einstiegspunkt und Asset-Pfad und schreibt das
  // Ergebnis nach `dist/server/wrangler.json`. Das ist die Datei, die
  // deployt wird (Workers Builds macht das automatisch):
  //
  //     npx astro build
  //     npx wrangler deploy --config dist/server/wrangler.json
  // `not_found_handling` steht bewusst nicht hier (Standard: "none").
  //
  // Mit "404-page" beantwortet Cloudflares Asset-Router jede *Navigation* auf
  // einen Pfad ohne passende Datei direkt mit `404.html` — der Worker läuft
  // dann gar nicht. `/keystatic` ist keine Datei, sondern wird vom Worker
  // gerendert, und war deshalb im Browser tot (per `curl` dagegen erreichbar,
  // weil das keine Navigation ist).
  //
  // Ohne den Schlüssel fällt alles, was keine Datei ist, an den Worker. Astro
  // rendert die eigene 404-Seite dort weiterhin selbst.
  "assets": {
    "directory": "./dist/client"
  },

  // Die Seite antwortet auf https://flamingo.resa.dev. `custom_domain` lässt
  // Cloudflare den DNS-Eintrag anlegen und pflegen — die Zone `resa.dev` muss
  // dafür in diesem Account liegen.
  //
  // Hier stand ursprünglich die Domain des Lumos-Starters
  // (`lumosframework.timothyricks.com`). Die Zone gehört einem fremden
  // Account, deshalb konnte Cloudflare den DNS-Eintrag nicht anlegen und der
  // Deploy brach mit Fehler 10082 ab.
  "routes": [
    {
      "pattern": "flamingo.resa.dev",
      "custom_domain": true
    }
  ],

  // Zusätzliche workers.dev-Adresse als Rückfallebene, solange die Domain
  // frisch ist. Auf `false` setzen, sobald flamingo.resa.dev sicher steht —
  // dann ist auch `/keystatic` nur noch über die eigene Domain erreichbar.
  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
