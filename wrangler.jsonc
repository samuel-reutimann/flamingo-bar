{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flamingo-bar",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],

  // Seit Keystatic ist das kein reiner Asset-Worker mehr: die Redaktion unter
  // `/keystatic` und ihre API-Routen laufen serverseitig. Alle Inhaltsseiten
  // bleiben vorgerendert und kommen weiterhin als Datei aus `assets`.
  //
  // `main` steht bewusst nicht hier — `@astrojs/cloudflare` liest diese Datei
  // beim Build, ergänzt Einstiegspunkt und Asset-Pfad und schreibt das
  // Ergebnis nach `dist/server/wrangler.json`. Das ist die Datei, die
  // deployt wird (Workers Builds macht das automatisch):
  //
  //     npx astro build
  //     npx wrangler deploy --config dist/server/wrangler.json
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },

  // Vorläufige Adresse: https://flamingo-bar.<dein-subdomain>.workers.dev
  //
  // Hier stand die Domain des Lumos-Starters (`lumosframework.timothyricks.com`).
  // Die Zone gehört einem fremden Account, deshalb konnte Cloudflare den
  // DNS-Eintrag nicht anlegen und der Deploy brach mit Fehler 10082 ab.
  //
  // Sobald `flamingobar-langenthal.ch` als Zone in diesem Cloudflare-Account
  // liegt, hier ergänzen — dann verschwindet die workers.dev-Adresse:
  //
  //     "routes": [
  //       { "pattern": "www.flamingobar-langenthal.ch", "custom_domain": true }
  //     ]
  "workers_dev": true,

  "observability": {
    "enabled": true
  }
}
